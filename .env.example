# Copiar a .env (NUNCA subir .env a Git).
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Origen/es de la UI, separados por comas; sin este valor CORS queda deshabilitado.
CORS_ORIGINS=http://localhost:4200

DATABASE_URL="postgresql://postgres:password@localhost:5432/new-project?schema=public"

AUTH_ACCESS_SECRET=di1K0+2(vfLo8D!vZ$C&gJ=)T9jJ-S`}sR8US6&yQ]aN-Q<£b)


# Ejemplo LOCAL. Ajustar usuario, contraseña, puerto y base en PostgreSQL.
#DATABASE_URL="postgresql://postgres:change_me@localhost:5432/gastro_core?schema=public"
# Opcional: conexión directa para migraciones si DATABASE_URL es un pooler.
DIRECT_URL="postgresql://postgres:password@localhost:5432/new-project?schema=public"
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

# Auth — usar secretos únicos por instalación, fuera de Git.
# Generar: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_SECRET=
AUTH_ACCESS_ISSUER=gastro-core
AUTH_ACCESS_AUDIENCE=gastro-ui
# No usar credenciales de ejemplo en producción
BOOTSTRAP_COMPANY_NAME=Gastro Core



