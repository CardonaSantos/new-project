      "key": "restrictedToken",
      "value": ""
    },
    {
      "key": "sucursalId",
      "value": ""
    },
    {
      "key": "varianteId",
      "value": ""
    },
    {
      "key": "activeCustomerId",
      "value": ""
    },
    {
      "key": "inactiveCustomerId",
      "value": ""
    },
    {
      "key": "integrationOrderId",
      "value": ""
    },
    {
      "key": "integrationOrderVersion",
      "value": ""
    },
    {
      "key": "integrationRun",
      "value": ""
    },
    {
      "key": "replacementCustomerId",
      "value": ""
    }
  ]
}
