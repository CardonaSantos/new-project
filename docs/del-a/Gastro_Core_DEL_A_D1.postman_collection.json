          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);pm.expect(pm.response.json().activo).to.eql(false);"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Historical detail after deactivation",
      "request": {
