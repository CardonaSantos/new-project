            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "url": "{{baseUrl}}/api/deliveries/{{deliveryId}}/dispatch",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D2:{{deliveryRun}}:dispatch\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);",
              "pm.expect(pm.response.json().estado).to.equal('EN_REPARTO');"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Reject destination change after dispatch",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
