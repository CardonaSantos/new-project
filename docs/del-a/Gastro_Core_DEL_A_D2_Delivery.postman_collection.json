    },
    {
      "name": "19 Confirm delivery cancellation audit history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "url": "{{baseUrl}}/api/deliveries/{{deliveryId2}}/events"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const actions=pm.response.json().data.map(x=>x.accion);",
              "pm.expect(actions).to.include('DELIVERY_ASSIGNED');",
              "pm.expect(actions).to.include('DELIVERY_CANCELLED');"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
