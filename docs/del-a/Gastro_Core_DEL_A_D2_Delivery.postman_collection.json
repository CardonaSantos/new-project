          }
        ],
        "url": "{{baseUrl}}/api/deliveries/{{deliveryId}}/destination",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D2:{{deliveryRun}}:late-destination\",\n  \"direccionTexto\": \"Zona 3, Calle 7 DEV\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(409);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Complete delivery (no cash registered in D2)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "url": "{{baseUrl}}/api/deliveries/{{deliveryId}}/complete",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D2:{{deliveryRun}}:complete\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);",
              "const j=pm.response.json();pm.expect(j.estado).to.equal('ENTREGADA');",
              "pm.expect(j.cobrableContraEntrega).to.equal('0.00');"
            ]
          }
        }
      ]
    },
