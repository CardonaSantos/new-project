            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D3:{{runId}}:cash-pay\",\n  \"cuentaId\": \"{{cashAccountId}}\",\n  \"monto\": \"22.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Idempotent cash payment',()=>pm.response.to.have.status(201));",
              "pm.expect(pm.response.json().pagoId).to.equal(pm.collectionVariables.get('courierPaymentId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Account now marked as paid; courier Pago without turno",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/accounts/{{cashAccountId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PAY-A account read',()=>pm.response.to.have.status(200));",
              "const j=pm.response.json();pm.expect(String(j.pagado)).to.equal('22.00');",
              "const p=j.pagos.find(p=>p.id===pm.collectionVariables.get('courierPaymentId'));",
              "pm.expect(p.recibidoPorRepartidor).to.equal(true);",
              "pm.expect(p.turnoId).to.equal(null);"
            ]
          }
        }
      ]
    },
