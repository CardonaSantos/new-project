      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Platform channel created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('channelId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "19 Create platform DELIVERY order",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sucursalId\": \"{{sucursalId}}\",\n  \"modalidad\": \"DELIVERY\",\n  \"origen\": \"PLATAFORMA\",\n  \"claveOperacion\": \"D3:{{runId}}:order-platform\",\n  \"enviarCocina\": false,\n  \"clienteId\": \"{{customerId}}\",\n  \"lineas\": [\n    {\n      \"varianteId\": \"{{varianteId}}\",\n      \"cantidad\": \"1.000\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Platform order created',()=>pm.response.to.have.status(201));",
              "const j=pm.response.json();pm.collectionVariables.set('platformOrderId',j.id);",
              "pm.collectionVariables.set('platformAccountId',j.cuentasComoOrden[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "20 Create platform delivery with its channel",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/deliveries",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D3:{{runId}}:platform-delivery\",\n  \"ordenId\": \"{{platformOrderId}}\",\n  \"direccionTexto\": \"Zona 2, domicilio sintético D3\",\n  \"repartidorId\": \"{{courierId}}\",\n  \"canalExternoId\": \"{{channelId}}\",\n  \"referenciaExterna\": \"TEST_{{runId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Platform delivery created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('platformDeliveryId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "21 Dispatch platform delivery",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/deliveries/{{platformDeliveryId}}/dispatch",
        "header": [
