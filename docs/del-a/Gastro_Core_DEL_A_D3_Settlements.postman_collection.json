{
  "info": {
    "name": "Gastro Core — DEL-A D3 Cobros y liquidaciones DEV",
    "description": "Solo PostgreSQL DEV. Requiere sucursal, turno de caja activo y cuenta FIN-A BANK activa. Genera cliente/órdenes/entregas/pagos de prueba. No usar producción.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Check existing shift for cash receipt",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cash/shifts?sucursalId={{sucursalId}}&page=1&limit=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('runId'))pm.collectionVariables.set('runId',Date.now().toString());",
              "const parts=new Intl.DateTimeFormat('en-US',{timeZone:'America/Guatemala',",
              " year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());",
              "const get=t=>parts.find(p=>p.type===t).value;",
              "pm.collectionVariables.set('deliveryDay',get('year')+'-'+get('month')+'-'+get('day'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Shifts accessible',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Check FIN-A bank accounts in branch",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/finance/accounts?sucursalId={{sucursalId}}&page=1&limit=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Financial accounts accessible',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create DEV customer",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/customers",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sucursalId\": \"{{sucursalId}}\",\n  \"claveOperacion\": \"D3:{{runId}}:customer\",\n  \"nombre\": \"D3 Cash customer DEV {{runId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for(const key of ['token','sucursalId','courierId','varianteId','turnoCajaId','bankAccountId']){",
              " if(!pm.collectionVariables.get(key))throw new Error('Debe configurar '+key+' de PostgreSQL DEV');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer created',()=>pm.response.to.have.status(201));pm.collectionVariables.set('customerId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create own-courier DELIVERY order",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sucursalId\": \"{{sucursalId}}\",\n  \"modalidad\": \"DELIVERY\",\n  \"origen\": \"CAJA\",\n  \"claveOperacion\": \"D3:{{runId}}:order-cash\",\n  \"enviarCocina\": false,\n  \"clienteId\": \"{{customerId}}\",\n  \"lineas\": [\n    {\n      \"varianteId\": \"{{varianteId}}\",\n      \"cantidad\": \"1.000\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order created',()=>pm.response.to.have.status(201));",
              "const j=pm.response.json();pm.collectionVariables.set('cashOrderId',j.id);",
              "pm.collectionVariables.set('cashAccountId',j.cuentasComoOrden[0].id);",
              "pm.collectionVariables.set('cashOrderTotal',String(j.total));"
            ]
          }
        }
      ]
    },
