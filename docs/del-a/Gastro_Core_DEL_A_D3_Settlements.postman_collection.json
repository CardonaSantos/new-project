        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D3:{{runId}}:shortage-note\",\n  \"montoDeclarado\": \"21.00\",\n  \"motivo\": \"Diferencia de prueba D3; liquidación permanece abierta\"\n}",
          "options": {
