            "exec": [
              "pm.test('Delivered',()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Platform gross 22 - commission 2 = net 20",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/deliveries/settlements/platforms",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D3:{{runId}}:platform-settlement\",\n  \"sucursalId\": \"{{sucursalId}}\",\n  \"canalId\": \"{{channelId}}\",\n  \"cuentaFinancieraId\": \"{{bankAccountId}}\",\n  \"periodoInicio\": \"{{deliveryDay}}\",\n  \"periodoFin\": \"{{deliveryDay}}\",\n  \"referencia\": \"BANK-D3-{{runId}}\",\n  \"lineas\": [\n    {\n      \"entregaId\": \"{{platformDeliveryId}}\",\n      \"cuentaId\": \"{{platformAccountId}}\",\n      \"importeBruto\": \"22.00\",\n      \"comision\": \"2.00\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('One net settlement',()=>pm.response.to.have.status(201));",
              "const j=pm.response.json();pm.expect(j.totalBruto).to.equal('22.00');",
              "pm.expect(j.totalComision).to.equal('2.00');pm.expect(j.totalNeto).to.equal('20.00');",
              "pm.collectionVariables.set('platformSettlementId',j.id);",
              "pm.collectionVariables.set('bankMovementId',j.movimientoFinancieroId);"
            ]
          }
        }
      ]
    },
    {
      "name": "24 Platform replay => one original financial movement",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/deliveries/settlements/platforms",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D3:{{runId}}:platform-settlement\",\n  \"sucursalId\": \"{{sucursalId}}\",\n  \"canalId\": \"{{channelId}}\",\n  \"cuentaFinancieraId\": \"{{bankAccountId}}\",\n  \"periodoInicio\": \"{{deliveryDay}}\",\n  \"periodoFin\": \"{{deliveryDay}}\",\n  \"referencia\": \"BANK-D3-{{runId}}\",\n  \"lineas\": [\n    {\n      \"entregaId\": \"{{platformDeliveryId}}\",\n      \"cuentaId\": \"{{platformAccountId}}\",\n      \"importeBruto\": \"22.00\",\n      \"comision\": \"2.00\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Idempotent platform net',()=>pm.response.to.have.status(201));",
              "pm.expect(pm.response.json().movimientoFinancieroId).to.equal(",
              "pm.collectionVariables.get('bankMovementId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "25 Verify platform settlement detail",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/deliveries/settlements/platforms/{{platformSettlementId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
