          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D3:{{runId}}:platform-dispatch\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Dispatched',()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Complete platform delivery",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/deliveries/{{platformDeliveryId}}/complete",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
