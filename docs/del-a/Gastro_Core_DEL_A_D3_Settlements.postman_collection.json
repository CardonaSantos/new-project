    {
      "name": "07 Courier receives cash (PAY-A, without cash movement)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/deliveries/{{cashDeliveryId}}/collect-cash",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D3:{{runId}}:cash-pay\",\n  \"cuentaId\": \"{{cashAccountId}}\",\n  \"monto\": \"22.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment recorded',()=>pm.response.to.have.status(201));",
              "pm.expect(pm.response.json().monto).to.equal('22.00');",
              "pm.collectionVariables.set('courierPaymentId',pm.response.json().pagoId);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Same cash key => same Pago (no double charge)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/deliveries/{{cashDeliveryId}}/collect-cash",
        "header": [
          {
            "key": "Authorization",
