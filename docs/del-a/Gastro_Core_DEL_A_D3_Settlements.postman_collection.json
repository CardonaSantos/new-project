          "raw": "{\n  \"ordenId\": \"{{cashOrderId}}\",\n  \"claveOperacion\": \"D3:{{runId}}:cash-delivery\",\n  \"direccionTexto\": \"Zona 1, Calle 3, domicilio sintético D3\",\n  \"repartidorId\": \"{{courierId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
