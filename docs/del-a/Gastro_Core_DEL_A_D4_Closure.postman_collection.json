        "body": {
          "mode": "raw",
          "raw": "{\n  \"sucursalId\": \"{{sucursalId}}\",\n  \"modalidad\": \"DELIVERY\",\n  \"origen\": \"CAJA\",\n  \"claveOperacion\": \"D4:{{runId}}:order-cancel\",\n  \"enviarCocina\": false,\n  \"lineas\": [\n    {\n      \"varianteId\": \"{{varianteId}}\",\n      \"cantidad\": \"1.000\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);pm.collectionVariables.set('cancelOrderId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Create pending delivery for that order",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/deliveries",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D4:{{runId}}:pending-delivery\",\n  \"ordenId\": \"{{cancelOrderId}}\",\n  \"direccionTexto\": \"Zona 2, domicilio DEV cancelación\",\n  \"repartidorId\": \"{{courierId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);pm.collectionVariables.set('cancelDeliveryId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "24 Cancel order directly; pending delivery automatically cancelled",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/orders/{{cancelOrderId}}/cancel",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivo\": \"Cliente canceló antes de iniciar el reparto\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);pm.expect(pm.response.json().estado).to.equal('CANCELADA');"
            ]
          }
        }
      ]
    },
    {
      "name": "25 Verify pending delivery is cancelled, not orphaned",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/deliveries/{{cancelDeliveryId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);pm.expect(pm.response.json().estado).to.equal('CANCELADA');"
            ]
          }
        }
      ]
    },
    {
      "name": "26 Verify synchronized audit history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/deliveries/{{cancelDeliveryId}}/events",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);pm.expect(pm.response.json().data.map(e=>e.accion)).to.include('DELIVERY_CANCELLED_WITH_ORDER');"
            ]
          }
        }
      ]
    }
