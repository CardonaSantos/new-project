          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);const b=pm.response.json().blockers;pm.expect(b).to.include('DELIVERY_NOT_COMPLETED');pm.expect(b).to.include('LINES_NOT_SENT');pm.expect(b).to.include('ACCOUNTS_UNPAID');"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Send prepared products to kitchen",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/orders/{{orderId}}/send",
        "header": [
          {
            "key": "Authorization",
