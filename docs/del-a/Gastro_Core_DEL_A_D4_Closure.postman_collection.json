          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveOperacion\": \"D4:{{runId}}:send\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);const j=pm.response.json();pm.expect(j.comandasComoOrden.length).to.be.greaterThan(0);pm.collectionVariables.set('ticketId',j.comandasComoOrden[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Readiness blocks while the kitchen is working",
