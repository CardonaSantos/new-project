{
  "info": {
    "name": "Gastro Core DEL-A D4 Integración y cierre DEV",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "D4 prueba las invariantes de cierre, cocina, cobro, entrega, Venta, caja y cancelación sincronizada. NO utilizar en producción."
  },
  "item": [
    {
      "name": "00 Previous D3 delivered but UNSENT order cannot be finalized",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/deliveries/{{historicDeliveryId}}/closure-readiness",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('runId'))pm.collectionVariables.set('runId',Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);pm.expect(pm.response.json().blockers).to.include('LINES_NOT_SENT');"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Finalization of historical D3 test is blocked",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/deliveries/{{historicDeliveryId}}/finalize-order",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(409);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 List kitchen routes — ensure variant has a route",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/kitchen/routes?sucursalId={{sucursalId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for(const k of ['token','sucursalId','courierId','varianteId','turnoCajaId'])if(!pm.collectionVariables.get(k))throw new Error('Variable faltante '+k);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create new DELIVERY order, no kitchen send yet",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sucursalId\": \"{{sucursalId}}\",\n  \"modalidad\": \"DELIVERY\",\n  \"origen\": \"CAJA\",\n  \"claveOperacion\": \"D4:{{runId}}:order-ready\",\n  \"enviarCocina\": false,\n  \"lineas\": [\n    {\n      \"varianteId\": \"{{varianteId}}\",\n      \"cantidad\": \"1.000\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);const j=pm.response.json();pm.collectionVariables.set('orderId',j.id);pm.collectionVariables.set('accountId',j.cuentasComoOrden[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create and assign delivery instantly",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/deliveries",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-sucursal-id",
            "value": "{{sucursalId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ordenId\": \"{{orderId}}\",\n  \"claveOperacion\": \"D4:{{runId}}:delivery\",\n  \"repartidorId\": \"{{courierId}}\",\n  \"direccionTexto\": \"Zona 1, domicilio sintético D4\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);pm.collectionVariables.set('deliveryId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Readiness explains missing delivery, kitchen and payment",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/deliveries/{{deliveryId}}/closure-readiness",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
