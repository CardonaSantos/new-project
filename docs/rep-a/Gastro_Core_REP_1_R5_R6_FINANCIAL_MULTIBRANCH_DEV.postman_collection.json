        "url": {
          "raw": "{{baseUrl}}/api/reports/analytics/sources/PAYMENT_SALES_RECON?sucursalId={{sucursalId}}&periodo=PERSONALIZADO&desde={{desde}}&hasta={{hasta}}&page=1&limit=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reports",
            "analytics",
            "sources",
            "PAYMENT_SALES_RECON"
          ],
          "query": [
            {
              "key": "sucursalId",
              "value": "{{sucursalId}}"
            },
            {
              "key": "periodo",
              "value": "PERSONALIZADO"
            },
            {
              "key": "desde",
              "value": "{{desde}}"
            },
            {
              "key": "hasta",
              "value": "{{hasta}}"
