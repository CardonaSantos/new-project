              "key": "limit",
              "value": "100"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const r=pm.response.json();\nconst cents=s=>{const m=/^(-?)(\\d+)\\.(\\d{2})$/.exec(String(s));pm.expect(m).not.to.equal(null);return (m[1]==='-'?-1n:1n)*(BigInt(m[2])*100n+BigInt(m[3]));};\n",
              "pm.expect(r.data).to.be.an('array');\npm.expect(r.meta.total).to.be.at.least(0);\npm.expect(r.data.length).to.be.at.most(r.meta.limit);\npm.expect(r.meta.totalPages).to.equal(Math.ceil(r.meta.total/r.meta.limit));\npm.expect(r.sucursal.id).to.equal(pm.collectionVariables.get('sucursalId'));\n",
              "pm.expect(r.source).to.equal('PAYMENT_SALES_RECON');\npm.expect(r.totales.cuentasConVenta+r.totales.cuentasSinVenta).to.equal(r.totales.cuentas);\npm.expect(cents(r.totales.cobrado)-cents(r.totales.reembolsadoHistorico)).to.equal(cents(r.totales.netoHistorico));\nfor(const c of r.data){\n pm.expect(c.reconocimientoVenta).to.equal(c.ventaId?'CON_VENTA':'SIN_VENTA');\n pm.expect(cents(c.cobrado)-cents(c.reembolsadoHistorico)).to.equal(cents(c.netoHistorico));\n}"
            ]
          }
        }
      ]
    },
