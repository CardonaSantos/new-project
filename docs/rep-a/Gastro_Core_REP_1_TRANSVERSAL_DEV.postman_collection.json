  "item": [
    {
      "name": "00 Líneas de venta por producto y orden",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/reports/analytics/sources/SALES_LINES?sucursalId={{sucursalId}}&periodo=PERSONALIZADO&desde={{desde}}&hasta={{hasta}}&page=1&limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const r=pm.response.json();",
              "pm.expect(r.source).to.equal('SALES_LINES');",
              "pm.expect(r.periodo.desde).to.equal(pm.variables.get('desde'));",
              "pm.expect(r.periodo.hasta).to.equal(pm.variables.get('hasta'));",
              "pm.expect(r.data).to.be.an('array');",
              "pm.expect(r.totales).to.be.an('object');",
              "pm.expect(r.meta).to.have.property('total');",
              "pm.expect(r.data.length).to.be.at.most(r.meta.limit);",
              "pm.expect(r).not.to.have.property('note');",
              "pm.expect(r).not.to.have.property('definicion');",
              "pm.expect(r).not.to.have.property('definitions');",
              "pm.expect(r.data.every(x=>typeof x.id==='string')).to.equal(true);",
              "if(r.meta.total<=100)pm.expect(r.data.length).to.equal(r.meta.total);",
              "pm.expect(r.porProducto).to.be.an('array');",
              "pm.expect(r.porCategoria).to.be.an('array');",
              "const cents = v => {const m=/^(-?)(\\d+)\\.(\\d{2})$/.exec(String(v)); pm.expect(m).not.to.equal(null); return (m[1]==='-'?-1:1)*(Number(m[2])*100+Number(m[3]));};",
              "pm.expect(r.porProducto.reduce((acc,x)=>acc+cents(x.importe),0)).to.equal(cents(r.totales.importeLineas));",
              "pm.expect(r.porCategoria.reduce((acc,x)=>acc+cents(x.importe),0)).to.equal(cents(r.totales.importeLineas));",
              "pm.expect(r.porVariante).to.be.an('array');",
              "pm.expect(r.porModalidad).to.be.an('array');",
              "pm.expect(r.porVariante.reduce((acc,x)=>acc+cents(x.importe),0)).to.equal(cents(r.totales.importeLineas));",
              "pm.expect(r.porModalidad.reduce((acc,x)=>acc+cents(x.importe),0)).to.equal(cents(r.totales.importeLineas));",
              "pm.expect(r.porVariante.reduce((acc,x)=>acc+cents(x.descuentos),0)).to.equal(cents(r.totales.descuentos));",
              "pm.expect(r.porModalidad.reduce((acc,x)=>acc+cents(x.descuentos),0)).to.equal(cents(r.totales.descuentos));",
              "pm.expect(r.porModalidad.every(x=>['MESA','MOSTRADOR','PARA_LLEVAR','DELIVERY'].includes(x.modalidad))).to.equal(true);"
            ]
          }
        }
      ]
    },
