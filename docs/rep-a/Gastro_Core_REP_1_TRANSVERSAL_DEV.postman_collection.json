    "description": "Verificar 8 fuentes transaccionales; los registros son reales, por sucursal y fecha operativa. Requiere permisos reports.read + permisos del módulo. No modificar la DB durante la batería."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "sucursalId",
      "value": "cmv8p4k3x0001u4v4xor2zgqu"
    },
    {
      "key": "fechaOperativa",
      "value": "2026-10-30"
    },
    {
      "key": "desde",
      "value": "2026-10-01"
    },
    {
      "key": "hasta",
      "value": "2026-10-30"
    }
