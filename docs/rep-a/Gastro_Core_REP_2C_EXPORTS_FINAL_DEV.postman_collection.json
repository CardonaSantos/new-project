{
  "info": {
    "name": "Gastro Core — REP-2C final | Reportes claros con Q, sin IDs (11 pruebas)",
    "description": "Pruebas de aceptación final de los exportadores administrativos: XLSX con Resumen/Diario/Detalle, importes Q numéricos (sumables), columnas sin IDs técnicos, PDF legible con día de consulta visible y CSV con montos numéricos etiquetados (Q). Hay 11 solicitudes (período, día y negativas 400). Ejecutar los formatos XLSX/PDF con Send and Download y abrirlos. La prueba visual no se sustituye por un HTTP 200. Guardar captura del Excel y PDF, y reporte de Postman; no enviar credenciales/token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Período — Ventas CSV sin IDs, columnas Q",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reports/analytics/exports/SALES_COSTS?sucursalId={{sucursalId}}&periodo=PERSONALIZADO&desde={{desde}}&hasta={{hasta}}&format=CSV",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reports",
            "analytics",
            "exports",
            "SALES_COSTS"
          ],
          "query": [
            {
              "key": "sucursalId",
              "value": "{{sucursalId}}"
            },
            {
              "key": "periodo",
              "value": "PERSONALIZADO"
            },
            {
              "key": "desde",
              "value": "{{desde}}"
            },
            {
              "key": "hasta",
              "value": "{{hasta}}"
            },
            {
              "key": "format",
              "value": "CSV"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
              "const f=pm.response.headers.get('Content-Disposition');",
              "pm.expect(f).to.match(/^attachment; filename=\"Gastro_Core_/);",
              "pm.expect(f).to.include('.csv');",
              "pm.expect(pm.response.headers.get('X-Report-SHA256')).to.match(/^[0-9a-f]{64}$/);",
              "pm.expect(Number(pm.response.headers.get('Content-Length'))).to.be.above(0);",
              "pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
              "pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.equal('nosniff');",
              "pm.expect(pm.response.size().body).to.be.greaterThan(20);",
              "const raw=pm.response.text();",
              "pm.expect(raw).to.include('\\r\\n');"
            ]
          }
        }
      ]
    },
