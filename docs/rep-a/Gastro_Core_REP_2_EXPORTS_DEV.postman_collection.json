{
  "info": {
    "name": "Gastro Core REP-2B — Exportaciones profesionales mensual y diario (11 pruebas)",
    "description": "XLSX nuevo: Resumen, Diario y Detalle; debe abrir en Excel sin reparaciones de styles.xml. PDF nuevo: portada KPIs, fecha operativa real y detalle legible. Las tres pruebas finales son de un solo día. Guardar y abrir archivos binarios, no basta solo status 200. Pruebas TXT y sin sucursal responden 400.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Exportar SALES_COSTS CSV",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reports/analytics/exports/SALES_COSTS?sucursalId={{sucursalId}}&periodo=PERSONALIZADO&desde={{desde}}&hasta={{hasta}}&format=CSV",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reports",
            "analytics",
            "exports",
            "SALES_COSTS"
          ],
          "query": [
            {
              "key": "sucursalId",
              "value": "{{sucursalId}}"
            },
            {
              "key": "periodo",
              "value": "PERSONALIZADO"
            },
            {
              "key": "desde",
              "value": "{{desde}}"
            },
            {
              "key": "hasta",
              "value": "{{hasta}}"
            },
            {
              "key": "format",
              "value": "CSV"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
              "const f=pm.response.headers.get('Content-Disposition');",
              "pm.expect(f).to.match(/^attachment; filename=\"Gastro_Core_/);",
              "pm.expect(f).to.include('.csv');",
              "pm.expect(pm.response.headers.get('X-Report-SHA256')).to.match(/^[0-9a-f]{64}$/);",
              "pm.expect(Number(pm.response.headers.get('Content-Length'))).to.be.above(0);",
              "pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
              "pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.equal('nosniff');",
              "pm.expect(pm.response.size().body).to.be.greaterThan(20);",
              "const raw=pm.response.text();",
              "pm.expect(raw).to.include('\\r\\n');"
            ]
          }
        }
      ]
    },
