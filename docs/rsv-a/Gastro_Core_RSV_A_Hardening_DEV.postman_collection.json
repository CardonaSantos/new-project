          "raw": "{\n  \"sucursalId\": \"{{sucursalId}}\",\n  \"nombreContacto\": \"RSV DEV reserva duplicada\",\n  \"personas\": \"2\",\n  \"inicio\": \"{{suiteStart}}\",\n  \"fin\": \"{{suiteEnd}}\",\n  \"estadoInicial\": \"CONFIRMADA\",\n  \"mesaIds\": [\n    \"{{secondTableId}}\"\n  ],\n  \"claveOperacion\": \"RSV-HARD:{{runId}}:overlap\"\n}",
          "options": {
