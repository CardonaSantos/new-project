{
  "info": {
    "name": "Gastro Core RSV-A — QA Complementaria R1-R4 DEV",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "17 requests; fresh availability before/after, PENDIENTE->CONFIRMADA, cancel + replay, multi-table and cleanup. No SMS/email. DEV only."
  },
  "item": [
    {
      "name": "00 NEW future timeslot — must be free BEFORE booking",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations/availability?sucursalId={{sucursalId}}&inicio={{suiteStart}}&fin={{suiteEnd}}&personas=2"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for(const k of ['token','sucursalId'])if(!pm.collectionVariables.get(k))throw Error('Configura variable: '+k);",
              "if(!pm.collectionVariables.get('runId'))pm.collectionVariables.set('runId',Date.now().toString());",
              "if(!pm.collectionVariables.get('suiteStart')){",
              " const start=new Date(Date.now()+150*60000);",
              " pm.collectionVariables.set('suiteStart',start.toISOString());",
              " pm.collectionVariables.set('suiteEnd',new Date(start.getTime()+90*60000).toISOString());",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const j=pm.response.json();",
              "const found=j.mesas.find(x=>x.disponible&&x.capacidad>=2);",
              "if(!found)throw Error('No free table for this NEW slot. Reset runId/suiteStart or configure a table.');",
              "pm.collectionVariables.set('tableId',found.id);",
              "pm.collectionVariables.set('roomId',found.sala.id);",
              "pm.collectionVariables.set('baseCapacity',String(found.capacidad));",
              "pm.collectionVariables.set('partyMulti',String(found.capacidad+1));",
              "pm.test('Fresh table available',()=>pm.expect(found.motivo).to.equal(null));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Create PENDIENTE; no extra approval required for normal CONFIRMADA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sucursalId\": \"{{sucursalId}}\",\n  \"nombreContacto\": \"RSV DEV pendiente\",\n  \"personas\": \"2\",\n  \"inicio\": \"{{suiteStart}}\",\n  \"fin\": \"{{suiteEnd}}\",\n  \"estadoInicial\": \"PENDIENTE\",\n  \"mesaIds\": [\n    \"{{tableId}}\"\n  ],\n  \"claveOperacion\": \"RSV-HARD:{{runId}}:pending\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);const j=pm.response.json();",
              "pm.expect(j.estado).to.equal('PENDIENTE');",
              "pm.collectionVariables.set('pendingId',j.id);",
              "pm.expect(j.mesas[0].sala.nombre).to.be.a('string');"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Availability now RESERVADA for the SAME time slot",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations/availability?sucursalId={{sucursalId}}&inicio={{suiteStart}}&fin={{suiteEnd}}&personas=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);const j=pm.response.json();",
              "const row=j.mesas.find(t=>t.id===pm.collectionVariables.get('tableId'));",
              "pm.expect(row.disponible).to.equal(false);",
              "pm.expect(row.motivo).to.equal('RESERVADA');",
              "pm.expect(row.reservaConflictoId).to.equal(pm.collectionVariables.get('pendingId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Confirm PENDIENTE directly",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations/{{pendingId}}/confirm",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);const j=pm.response.json();",
              "pm.expect(j.estado).to.equal('CONFIRMADA');",
              "pm.expect(j.eventos.filter(e=>e.accion==='RESERVATION_CONFIRMED')).to.have.length(1);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Confirmation replay — no duplicate audit event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations/{{pendingId}}/confirm",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);",
              "pm.expect(pm.response.json().eventos.filter(e=>e.accion==='RESERVATION_CONFIRMED')).to.have.length(1);"
            ]
          }
        }
      ]
    },
    {
