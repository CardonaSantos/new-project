      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const j=pm.response.json();",
              "pm.expect(j.mesas.find(x=>x.id===pm.collectionVariables.get('tableId')).disponible).to.equal(true);",
              "pm.expect(j.mesas.some(x=>x.id===pm.collectionVariables.get('secondTableId'))).to.equal(false);"
            ]
          }
        }
      ]
    }
