        "url": "{{baseUrl}}/api/reservations/{{pendingId}}/cancel",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivo\": \"No\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(400);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Cancel CONFIRMADA; detailed reason and audit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations/{{pendingId}}/cancel",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivo\": \"Cliente no llegará al restaurante\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);const j=pm.response.json();",
              "pm.expect(j.estado).to.equal('CANCELADA');",
              "const e=j.eventos.filter(e=>e.accion==='RESERVATION_CANCELLED');",
              "pm.expect(e).to.have.length(1);",
              "pm.expect(e[0].detalle).to.equal('Cliente no llegará al restaurante');"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Cancel replay — no duplicated event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
