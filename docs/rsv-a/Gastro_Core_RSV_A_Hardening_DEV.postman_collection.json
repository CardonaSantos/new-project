        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivo\": \"Cliente no llegará al restaurante\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);",
              "pm.expect(pm.response.json().eventos.filter(e=>e.accion==='RESERVATION_CANCELLED')).to.have.length(1);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Availability restored after cancellation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations/availability?sucursalId={{sucursalId}}&inicio={{suiteStart}}&fin={{suiteEnd}}&personas=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);const j=pm.response.json();",
              "const row=j.mesas.find(t=>t.id===pm.collectionVariables.get('tableId'));",
              "pm.expect(row.disponible).to.equal(true);",
              "pm.expect(row.reservaConflictoId).to.equal(null);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Create SECOND DEV table in same room, capacity 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tables",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"salaId\": \"{{roomId}}\",\n  \"numero\": \"R{{runId}}\",\n  \"capacidad\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);",
              "const j=pm.response.json();",
              "pm.collectionVariables.set('secondTableId',j.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Create one reservation on TWO tables, combined capacity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sucursalId\": \"{{sucursalId}}\",\n  \"nombreContacto\": \"RSV DEV grupo de mesas\",\n  \"personas\": \"{{partyMulti}}\",\n  \"inicio\": \"{{suiteStart}}\",\n  \"fin\": \"{{suiteEnd}}\",\n  \"estadoInicial\": \"CONFIRMADA\",\n  \"mesaIds\": [\n    \"{{tableId}}\",\n    \"{{secondTableId}}\"\n  ],\n  \"claveOperacion\": \"RSV-HARD:{{runId}}:multi\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);const j=pm.response.json();",
              "pm.expect(j.estado).to.equal('CONFIRMADA');",
              "pm.expect(j.mesas).to.have.length(2);",
              "pm.expect(j.capacidadAsignada).to.be.gte(Number(pm.collectionVariables.get('partyMulti')));",
              "pm.collectionVariables.set('multiId',j.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Availability blocks BOTH allocated tables",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations/availability?sucursalId={{sucursalId}}&inicio={{suiteStart}}&fin={{suiteEnd}}&personas=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);const j=pm.response.json();",
              "for(const id of [pm.collectionVariables.get('tableId'),pm.collectionVariables.get('secondTableId')]){",
              " const row=j.mesas.find(t=>t.id===id);",
              " pm.expect(row.motivo).to.equal('RESERVADA');",
              " pm.expect(row.reservaConflictoId).to.equal(pm.collectionVariables.get('multiId'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Enriched detail contains both tables, room, and creator",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations/{{multiId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);const j=pm.response.json();",
              "pm.expect(j.mesas).to.have.length(2);",
              "pm.expect(j.mesas[0].sala.nombre).to.be.a('string');",
              "pm.expect(j.creadaPor.nombre).to.be.a('string');",
              "pm.expect(j.eventos[0].actor.nombre).to.be.a('string');"
            ]
          }
        }
      ]
    },
    {
      "name": "13 New booking of ONE allocated table rejected (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
