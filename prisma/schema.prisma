  liquidacionCanalExternosComoCanal LiquidacionCanalExterno[] @relation("LiquidacionCanalExterno_canal_CanalExterno")
}

model Entrega {
  id                    String            @id @default(cuid())
  ordenId               String            @unique
  orden                 Orden             @relation("Entrega_orden_Orden", fields: [ordenId], references: [id], onDelete: Restrict)
  direccionId           String?
  direccion             DireccionCliente? @relation("Entrega_direccion_DireccionCliente", fields: [direccionId], references: [id], onDelete: SetNull)
  direccionTexto        String
  referenciaDireccion   String?
  telefonoContacto      String?
  repartidorId          String?
  repartidor            Usuario?          @relation("Entrega_repartidor_Usuario", fields: [repartidorId], references: [id], onDelete: SetNull)
  canalExternoId        String?
  canalExterno          CanalExterno?     @relation("Entrega_canalExterno_CanalExterno", fields: [canalExternoId], references: [id], onDelete: Restrict)
