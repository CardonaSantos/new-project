 monto Decimal @db.Decimal(18,2)
 creadaEn DateTime @default(now()) @db.Timestamptz(3)
 @@unique([notaId,facturaId])
}
model ReintegroProveedor {
 id String @id @default(cuid())
 notaId String
 nota NotaCreditoProveedor @relation(fields:[notaId],references:[id],onDelete:Restrict)
 metodo MetodoPago
 monto Decimal @db.Decimal(18,2)
 referencia String?
 turnoCajaId String?
 estado EstadoReintegroProveedor @default(PENDIENTE)
 confirmadoEn DateTime? @db.Timestamptz(3)
 usuarioId String
 creadoEn DateTime @default(now()) @db.Timestamptz(3)
 movimientoCajaId String? @unique
}
model ConsumoInterno {
