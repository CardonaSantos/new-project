 almacenId String
 almacen Almacen @relation(fields:[almacenId],references:[id],onDelete:Restrict)
 estado EstadoDevolucionProveedor @default(BORRADOR)
 motivo String
 usuarioId String
 confirmadoEn DateTime? @db.Timestamptz(3)
 creadoEn DateTime @default(now()) @db.Timestamptz(3)
 lineas DevolucionProveedorLinea[]
 @@index([sucursalId,estado,creadoEn])
}
model DevolucionProveedorLinea {
 id String @id @default(cuid())
 devolucionId String
 devolucion DevolucionProveedor @relation(fields:[devolucionId],references:[id],onDelete:Restrict)
 recepcionLineaId String
 recepcionLinea RecepcionCompraLinea @relation(fields:[recepcionLineaId],references:[id],onDelete:Restrict)
 articuloId String
 ubicacionId String
 loteId String?
 cantidadBase Decimal @db.Decimal(20,6)
 costoContable Decimal? @db.Decimal(18,6)
 movimientoId String? @unique
 @@index([recepcionLineaId])
}
model NotaCreditoProveedor {
 id String @id @default(cuid())
 proveedorId String
 proveedor Proveedor @relation(fields:[proveedorId],references:[id],onDelete:Restrict)
 sucursalId String
 sucursal Sucursal @relation(fields:[sucursalId],references:[id],onDelete:Restrict)
 numeroDocumento String
 motivo String
 // Desglose fiscal de la nota: el crédito comercial se representa por
 // subtotal + impuestos, sin alterar la factura ni el Kardex original.
 subtotal Decimal @db.Decimal(18,2)
 impuestos Decimal @default(0) @db.Decimal(18,2)
 total Decimal @db.Decimal(18,2)
 estado EstadoNotaCreditoProveedor @default(BORRADOR)
 devolucionId String?
 creadaEn DateTime @default(now()) @db.Timestamptz(3)
 confirmadaEn DateTime? @db.Timestamptz(3)
 aplicaciones AplicacionNotaCreditoProveedor[]
 reintegros ReintegroProveedor[]
 @@unique([proveedorId,numeroDocumento])
 @@index([sucursalId,estado])
}
model AplicacionNotaCreditoProveedor {
 id String @id @default(cuid())
 notaId String
 nota NotaCreditoProveedor @relation(fields:[notaId],references:[id],onDelete:Restrict)
 facturaId String
