  ventaLineasComoVenta VentaLinea[] @relation("VentaLinea_venta_Venta")

  @@unique([sucursalId, numero])
  @@index([sucursalId, cerradaEn])
}

model VentaLinea {
  id             String     @id @default(cuid())
  ventaId        String
  venta          Venta      @relation("VentaLinea_venta_Venta", fields: [ventaId], references: [id], onDelete: Restrict)
  ordenLineaId   String
  ordenLinea     OrdenLinea @relation("VentaLinea_ordenLinea_OrdenLinea", fields: [ordenLineaId], references: [id], onDelete: Restrict)
  descripcion    String
  cantidad       Decimal    @db.Decimal(18, 3)
  precioUnitario Decimal    @db.Decimal(18, 2)
  descuento      Decimal    @default(0) @db.Decimal(18, 2)
  subtotal       Decimal    @db.Decimal(18, 2)

  @@index([ventaId])
}

model CuentaFinanciera {
  id         String    @id @default(cuid())
  sucursalId String?
  sucursal   Sucursal? @relation("CuentaFinanciera_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  nombre     String
  tipo       String // BANCO, TARJETA_EMPRESA, EFECTIVO_EXTERNO, etc.
  moneda     String    @default("GTQ") @db.VarChar(3)
  activa     Boolean   @default(true)

  // Relaciones inversas (navegación Prisma)
  pagoProveedoresComoCuentaFinanciera          PagoProveedor[]           @relation("PagoProveedor_cuentaFinanciera_CuentaFinanciera")
  movimientoFinancierosComoCuenta              MovimientoFinanciero[]    @relation("MovimientoFinanciero_cuenta_CuentaFinanciera")
  rutasFinancierasComoCuenta                  RutaFinanciera[]          @relation("RutaFinanciera_cuenta_CuentaFinanciera")
  gastoOperativosComoCuentaFinanciera          GastoOperativo[]          @relation("GastoOperativo_cuentaFinanciera_CuentaFinanciera")
  lineasExtractoComoCuentaFinanciera LineaExtractoBancario[] @relation("LineaExtractoBancario_cuenta_CuentaFinanciera")
  liquidacionCanalExternosComoCuentaFinanciera LiquidacionCanalExterno[] @relation("LiquidacionCanalExterno_cuentaFinanciera_CuentaFinanciera")
}

model RutaFinanciera {
  id                String          @id @default(cuid())
