  activa     Boolean  @default(true)

  // Relaciones inversas (navegación Prisma)
  mesasComoSala Mesa[] @relation("Mesa_sala_Sala")

  @@unique([sucursalId, nombre])
}

model Mesa {
  id        String  @id @default(cuid())
  salaId    String
