  rutaPreparacionesComoEstacion       RutaPreparacion[] @relation("RutaPreparacion_estacion_EstacionPreparacion")
  comandasComoEstacion                Comanda[]         @relation("Comanda_estacion_EstacionPreparacion")

  @@unique([sucursalId, nombre])
