  monto             Decimal                     @db.Decimal(18, 2)
  estado            EstadoIntentoPago           @default(PENDIENTE)
  claveIdempotencia String                      @unique
  referenciaExterna String?
  codigoAutorizacion String?
  terminalReferencia String?
  respuestaCodigo   String?
  creadoEn          DateTime                    @default(now()) @db.Timestamptz(3)
  actualizadoEn     DateTime                    @updatedAt @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  pagosComoIntento Pago? @relation("Pago_intento_IntentoPago")

  @@index([proveedorId, referenciaExterna])
}

model Pago {
  id                    String       @id @default(cuid())
  cuentaId              String
  cuenta                Cuenta       @relation("Pago_cuenta_Cuenta", fields: [cuentaId], references: [id], onDelete: Restrict)
  intentoId             String?      @unique
  intento               IntentoPago? @relation("Pago_intento_IntentoPago", fields: [intentoId], references: [id], onDelete: Restrict)
  turnoId               String?
  turno                 TurnoCaja?   @relation("Pago_turno_TurnoCaja", fields: [turnoId], references: [id], onDelete: Restrict)
  cobradoPorId          String?
  cobradoPor            Usuario?     @relation("Pago_cobradoPor_Usuario", fields: [cobradoPorId], references: [id], onDelete: SetNull)
  metodo                MetodoPago
  monto                 Decimal      @db.Decimal(18, 2)
  referencia            String?
  codigoAutorizacion String?
  terminalReferencia String?
  efectivoRecibido Decimal? @db.Decimal(18, 2)
  vuelto           Decimal? @db.Decimal(18, 2)
