  varianteId  String?
  variante    VarianteProducto?   @relation("RutaPreparacion_variante_VarianteProducto", fields: [varianteId], references: [id], onDelete: Restrict)
  prioridad   Int                 @default(0)
  // Validar en servicio: exactamente una de categoriaId / varianteId.
}

model Comanda {
  id          String              @id @default(cuid())
  numero      String
  ordenId     String
  orden       Orden               @relation("Comanda_orden_Orden", fields: [ordenId], references: [id], onDelete: Restrict)
  estacionId  String
  estacion    EstacionPreparacion @relation("Comanda_estacion_EstacionPreparacion", fields: [estacionId], references: [id], onDelete: Restrict)
