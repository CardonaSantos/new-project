  cobradoEn             DateTime     @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  movimientoCajasComoPago             MovimientoCaja?             @relation("MovimientoCaja_pago_Pago")
  reembolsoPagosComoPago              ReembolsoPago[]             @relation("ReembolsoPago_pago_Pago")
  liquidacionRepartidorLineasComoPago LiquidacionRepartidorLinea? @relation("LiquidacionRepartidorLinea_pago_Pago")

  @@index([cuentaId, cobradoEn])
}

model ReembolsoPago {
  id                String   @id @default(cuid())
  pagoId            String
  pago              Pago     @relation("ReembolsoPago_pago_Pago", fields: [pagoId], references: [id], onDelete: Restrict)
  monto             Decimal  @db.Decimal(18, 2)
  motivo            String
  usuarioId         String
  usuario           Usuario  @relation("ReembolsoPago_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  referenciaExterna String?
  creadoEn          DateTime @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  movimientoCajasComoReembolso MovimientoCaja? @relation("MovimientoCaja_reembolso_ReembolsoPago")

  @@index([pagoId, creadoEn])
}

model Venta {
  id             String   @id @default(cuid())
  numero         String
  cuentaId       String   @unique
  cuenta         Cuenta   @relation("Venta_cuenta_Cuenta", fields: [cuentaId], references: [id], onDelete: Restrict)
  sucursalId     String
  sucursal       Sucursal @relation("Venta_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  clienteId      String?
  cliente        Cliente? @relation("Venta_cliente_Cliente", fields: [clienteId], references: [id], onDelete: SetNull)
