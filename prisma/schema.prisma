  ocupacionMesasComoMesa OcupacionMesa[] @relation("OcupacionMesa_mesa_Mesa")
  reservaMesasComoMesa   ReservaMesa[]   @relation("ReservaMesa_mesa_Mesa")
  accesoMesaQResComoMesa AccesoMesaQR[]  @relation("AccesoMesaQR_mesa_Mesa")

  @@unique([salaId, numero])
}

model OcupacionMesa {
  id           String    @id @default(cuid())
  mesaId       String
  mesa         Mesa      @relation("OcupacionMesa_mesa_Mesa", fields: [mesaId], references: [id], onDelete: Restrict)
  reservaId    String?
  reserva      Reserva?  @relation("OcupacionMesa_reserva_Reserva", fields: [reservaId], references: [id], onDelete: SetNull)
  abiertaEn    DateTime  @default(now()) @db.Timestamptz(3)
  cerradaEn    DateTime? @db.Timestamptz(3)
  abiertaPorId String
  abiertaPor   Usuario   @relation("OcupacionMesa_abiertaPor_Usuario", fields: [abiertaPorId], references: [id], onDelete: Restrict)

  // Relaciones inversas (navegación Prisma)
  ordenesComoOcupacionMesa Orden[] @relation("Orden_ocupacionMesa_OcupacionMesa")

  @@index([mesaId, cerradaEn])
}

model Orden {
  id              String            @id @default(cuid())
  numero          String
  sucursalId      String
  sucursal        Sucursal          @relation("Orden_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  ocupacionMesaId String?
  ocupacionMesa   OcupacionMesa?    @relation("Orden_ocupacionMesa_OcupacionMesa", fields: [ocupacionMesaId], references: [id], onDelete: Restrict)
  clienteId       String?
  cliente         Cliente?          @relation("Orden_cliente_Cliente", fields: [clienteId], references: [id], onDelete: SetNull)
  usuarioId       String?
  usuario         Usuario?          @relation("Orden_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  modalidad       ModalidadServicio
  origen          OrigenOrden
  estado          EstadoOrden       @default(ABIERTA)
  version         Int               @default(1)
  claveOperacion  String?           @unique
  solicitudHash   String?
  subtotal        Decimal           @default(0) @db.Decimal(18, 2)
  descuentoTotal  Decimal           @default(0) @db.Decimal(18, 2)
  total           Decimal           @default(0) @db.Decimal(18, 2)
  // Cancellation snapshot for future financial and loss reports; does not reverse stock.
  importeAnulado  Decimal           @default(0) @db.Decimal(18, 2)
  clasificacionCancelacion String?   @db.VarChar(30)
  motivoCancelacion String?          @db.VarChar(500)
  autorizadaCancelacionPreparada Boolean @default(false)
  observaciones   String?
  abiertaEn       DateTime          @default(now()) @db.Timestamptz(3)
  cerradaEn       DateTime?         @db.Timestamptz(3)
  canceladaEn     DateTime?         @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  consumoOrdenesComoOrden      ConsumoOrden[]       @relation("ConsumoOrden_orden_Orden")
  ordenLineasComoOrden         OrdenLinea[]         @relation("OrdenLinea_orden_Orden")
  cuentasComoOrden             Cuenta[]             @relation("Cuenta_orden_Orden")
  eventoOrdenesComoOrden       EventoOrden[]        @relation("EventoOrden_orden_Orden")
  comandasComoOrden            Comanda[]            @relation("Comanda_orden_Orden")
  entregasComoOrden            Entrega?             @relation("Entrega_orden_Orden")
  sesionAutoserviciosComoOrden SesionAutoservicio[] @relation("SesionAutoservicio_orden_Orden")

  @@unique([sucursalId, numero])
  @@index([sucursalId, estado, abiertaEn])
  @@index([sucursalId, clasificacionCancelacion, canceladaEn])
}

model OrdenLinea {
  id             String           @id @default(cuid())
  ordenId        String
  orden          Orden            @relation("OrdenLinea_orden_Orden", fields: [ordenId], references: [id], onDelete: Restrict)
  varianteId     String
  variante       VarianteProducto @relation("OrdenLinea_variante_VarianteProducto", fields: [varianteId], references: [id], onDelete: Restrict)
  nombreSnapshot String
  cantidad       Decimal          @db.Decimal(18, 3)
  precioUnitario Decimal          @db.Decimal(18, 2)
  recetaVersionId String?
  recetaVersion   RecetaVersion?   @relation("OrdenLinea_version_RecetaVersion",fields:[recetaVersionId],references:[id],onDelete:Restrict)
  composicionSnapshot Json?
  cantidadEnviada Decimal          @default(0) @db.Decimal(18, 3)
  descuento      Decimal          @default(0) @db.Decimal(18, 2)
  subtotal       Decimal          @db.Decimal(18, 2)
  notasCocina    String?
  canceladaEn    DateTime?        @db.Timestamptz(3)
  creadaEn       DateTime         @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  ordenLineaModificadoresComoOrdenLinea OrdenLineaModificador[] @relation("OrdenLineaModificador_ordenLinea_OrdenLinea")
  cuentaLineasComoOrdenLinea            CuentaLinea[]           @relation("CuentaLinea_ordenLinea_OrdenLinea")
  consumosComoOrdenLinea                ConsumoOrden[]           @relation("ConsumoOrden_ordenLinea_OrdenLinea")
  comandaLineasComoOrdenLinea           ComandaLinea[]          @relation("ComandaLinea_ordenLinea_OrdenLinea")
  ventaLineasComoOrdenLinea             VentaLinea[]            @relation("VentaLinea_ordenLinea_OrdenLinea")

  @@index([ordenId, creadaEn])
}

model OrdenLineaModificador {
  id              String      @id @default(cuid())
  ordenLineaId    String
  ordenLinea      OrdenLinea  @relation("OrdenLineaModificador_ordenLinea_OrdenLinea", fields: [ordenLineaId], references: [id], onDelete: Restrict)
  modificadorId   String
  modificador     Modificador @relation("OrdenLineaModificador_modificador_Modificador", fields: [modificadorId], references: [id], onDelete: Restrict)
  nombreSnapshot  String
  cantidad        Int         @default(1)
  recargoUnitario Decimal     @db.Decimal(18, 2)

  @@index([ordenLineaId])
}

model Cuenta {
  id        String       @id @default(cuid())
  ordenId   String
  orden     Orden        @relation("Cuenta_orden_Orden", fields: [ordenId], references: [id], onDelete: Restrict)
  nombre    String?
  estado    EstadoCuenta @default(ABIERTA)
  total     Decimal      @default(0) @db.Decimal(18, 2)
  pagado    Decimal      @default(0) @db.Decimal(18, 2)
  abiertaEn DateTime     @default(now()) @db.Timestamptz(3)
  cerradaEn DateTime?    @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  cuentaLineasComoCuenta CuentaLinea[] @relation("CuentaLinea_cuenta_Cuenta")
  intentoPagosComoCuenta IntentoPago[] @relation("IntentoPago_cuenta_Cuenta")
  pagosComoCuenta        Pago[]        @relation("Pago_cuenta_Cuenta")
  ventasComoCuenta       Venta?        @relation("Venta_cuenta_Cuenta")

  @@index([ordenId, estado])
}

model CuentaLinea {
  id               String     @id @default(cuid())
  cuentaId         String
  cuenta           Cuenta     @relation("CuentaLinea_cuenta_Cuenta", fields: [cuentaId], references: [id], onDelete: Restrict)
  ordenLineaId     String
  ordenLinea       OrdenLinea @relation("CuentaLinea_ordenLinea_OrdenLinea", fields: [ordenLineaId], references: [id], onDelete: Restrict)
  cantidadAsignada Decimal    @db.Decimal(18, 3)
  importeAsignado  Decimal    @db.Decimal(18, 2)

  @@unique([cuentaId, ordenLineaId])
}

model EventoOrden {
  id        String   @id @default(cuid())
  ordenId   String
  orden     Orden    @relation("EventoOrden_orden_Orden", fields: [ordenId], references: [id], onDelete: Restrict)
  usuarioId String?
  usuario   Usuario? @relation("EventoOrden_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  accion    String
  detalles  Json?
  creadoEn  DateTime @default(now()) @db.Timestamptz(3)

  @@index([ordenId, creadoEn])
}

