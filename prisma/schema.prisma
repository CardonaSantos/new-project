  cuentaFinanciera  CuentaFinanciera @relation("RutaFinanciera_cuenta_CuentaFinanciera", fields: [cuentaFinancieraId], references: [id], onDelete: Restrict)
  activa            Boolean         @default(true)
  actualizadoEn     DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([sucursalId, metodo])
  @@index([cuentaFinancieraId])
}

model MovimientoFinanciero {
  id             String           @id @default(cuid())
  cuentaId       String
  cuenta         CuentaFinanciera @relation("MovimientoFinanciero_cuenta_CuentaFinanciera", fields: [cuentaId], references: [id], onDelete: Restrict)
  monto          Decimal          @db.Decimal(18, 2) // firmado
  referenciaTipo String
  referenciaId   String
  descripcion    String?
  creadoEn       DateTime         @default(now()) @db.Timestamptz(3)

  lineasExtractoComoMovimiento LineaExtractoBancario[] @relation("LineaExtractoBancario_movimiento_MovimientoFinanciero")
  reversasComoOriginal ReversaFinanciera[] @relation("ReversaFinanciera_original_MovimientoFinanciero")
  reversasComoAjuste ReversaFinanciera[] @relation("ReversaFinanciera_ajuste_MovimientoFinanciero")
  @@index([cuentaId, creadoEn])
  @@index([referenciaTipo, referenciaId])
}


model LineaExtractoBancario {
 id String @id @default(cuid())
 cuentaFinancieraId String
 cuentaFinanciera CuentaFinanciera @relation("LineaExtractoBancario_cuenta_CuentaFinanciera",fields:[cuentaFinancieraId],references:[id],onDelete:Restrict)
 claveExterna String @db.VarChar(160)
 fecha DateTime @db.Date
 monto Decimal @db.Decimal(18,2)
 referencia String? @db.VarChar(160)
 descripcion String? @db.VarChar(500)
 movimientoFinancieroId String? @unique
 movimientoFinanciero MovimientoFinanciero? @relation("LineaExtractoBancario_movimiento_MovimientoFinanciero",fields:[movimientoFinancieroId],references:[id],onDelete:Restrict)
 importadoPorId String
 importadoPor Usuario @relation("LineaExtracto_importador_Usuario",fields:[importadoPorId],references:[id],onDelete:Restrict)
 conciliadoPorId String?
