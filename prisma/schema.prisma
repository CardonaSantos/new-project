  entregaId     String                  @unique
  entrega       Entrega                 @relation("LiquidacionCanalExternoLinea_entrega_Entrega", fields: [entregaId], references: [id], onDelete: Restrict)
  importeBruto  Decimal                 @db.Decimal(18, 2)
  comision      Decimal                 @default(0) @db.Decimal(18, 2)
  importeNeto   Decimal                 @db.Decimal(18, 2)
}

model LiquidacionRepartidor {
  id             String            @id @default(cuid())
  repartidorId   String
