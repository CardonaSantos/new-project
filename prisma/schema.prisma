  accesoMesaQr   AccesoMesaQR?            @relation("SesionAutoservicio_accesoMesaQr_AccesoMesaQR", fields: [accesoMesaQrId], references: [id], onDelete: SetNull)
  ordenId        String?
  orden          Orden?                   @relation("SesionAutoservicio_orden_Orden", fields: [ordenId], references: [id], onDelete: Restrict)
