// [S10] ESTACIONES, COMANDAS Y PREPARACIÓN
// ============================================================================

model EstacionPreparacion {
  id                 String            @id @default(cuid())
  sucursalId         String
  sucursal           Sucursal          @relation("EstacionPreparacion_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  nombre             String
  activa             Boolean           @default(true)
  ubicacionConsumoId String?
  ubicacionConsumo   UbicacionAlmacen? @relation("EstacionPreparacion_ubicacionConsumo_UbicacionAlmacen", fields: [ubicacionConsumoId], references: [id], onDelete: SetNull)

  // Relaciones inversas (navegación Prisma)
