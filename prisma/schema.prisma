 ubicacionId String
 loteId String?
 cantidad Decimal @db.Decimal(20,6)
 destinoUso String
 motivo String
 responsableId String
 movimientoId String @unique
 creadoEn DateTime @default(now()) @db.Timestamptz(3)
 @@index([ubicacionId,creadoEn])
