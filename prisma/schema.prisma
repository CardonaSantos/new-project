// GASTRO CORE — Prisma ORM 7 / PostgreSQL / NestJS ESM
// Revisar y validar migraciones antes de aplicarlas en una base de datos.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// GASTRO CORE — SCHEMA PRISMA v0.1 (una empresa por base de datos)
// PostgreSQL · NestJS · Prisma ORM 7 · Nomenclatura PascalCase/camelCase
// ============================================================================
// ÍNDICE DE SECCIONES — busque [SNN] en el editor para navegar
// [S00] Configuración Prisma y enumeraciones operativas
// [S01] EMPRESA, SUCURSALES Y DISPOSITIVOS
// [S02] IDENTIDAD, ROLES, PERMISOS Y AUDITORÍA
// [S03] CATÁLOGO COMERCIAL, VARIANTES Y MODIFICADORES
// [S04] ARTÍCULOS, UNIDADES, RECETAS Y EMPAQUES
// [S05] ALMACENES, LOTES, KARDEX Y CONTEOS
// [S06] PRODUCCIÓN Y CONSUMO REAL
// [S07] PROVEEDORES, COMPRAS, RECEPCIONES Y PAGOS
// [S08] REQUISICIONES Y TRANSFERENCIAS
// [S09] CLIENTES, MESAS, ÓRDENES Y CUENTAS
// [S10] ESTACIONES, COMANDAS Y PREPARACIÓN
// [S11] CAJA, PAGOS, VENTAS Y GASTOS
// [S12] DELIVERY Y CANALES EXTERNOS
// [S13] RESERVAS Y RECORDATORIOS
// [S14] AUTOSERVICIO Y EVENTOS TÉCNICOS
// [S15] PERFIL DE USUARIO Y MULTIMEDIA S3/SPACES
// ============================================================================
// CRITERIOS
// - FEL/CFDI/emisión fiscal: FUERA DE ESTA VERSIÓN expresamente.
// - Estado mínimo: no hay aprobaciones redundantes para operaciones normales.
// - Decimal(18,2): dinero total GTQ; Decimal(18,6): costo unitario;
//   Decimal(20,6): cantidades físicas; Decimal(24,10): conversiones.
// - NUNCA Float para importes, ingredientes o tasas.
// - Stock se registra por ubicación y lote; el Kardex es MovimientoInventario.
// - Registro de operación NO es emisión fiscal; Venta = comprobante INTERNO.
// - Para Prisma 7: DATABASE_URL se configura en prisma.config.ts.
// - Restricciones SQL avanzadas y riesgos pendientes documentados en README.
// ============================================================================

// ============================================================================
// [S00] CONFIGURACIÓN — Prisma ORM 7
// ============================================================================

// ============================================================================
// [S00] ENUMS OPERATIVOS MÍNIMOS
// ============================================================================

