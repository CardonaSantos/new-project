model Caja {
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation("Caja_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  codigo     String
  nombre     String
  activa     Boolean  @default(true)

  // Relaciones inversas (navegación Prisma)
  turnoCajasComoCaja TurnoCaja[] @relation("TurnoCaja_caja_Caja")

  @@unique([sucursalId, codigo])
}

model TurnoCaja {
  id               String    @id @default(cuid())
  cajaId           String
  caja             Caja      @relation("TurnoCaja_caja_Caja", fields: [cajaId], references: [id], onDelete: Restrict)
  cajeroId         String
  cajero           Usuario   @relation("TurnoCaja_cajero_Usuario", fields: [cajeroId], references: [id], onDelete: Restrict)
  fechaOperativa   DateTime  @db.Date
  fondoInicial     Decimal   @db.Decimal(18, 2)
  efectivoEsperado Decimal?  @db.Decimal(18, 2)
  efectivoContado  Decimal?  @db.Decimal(18, 2)
  diferencia       Decimal?  @db.Decimal(18, 2)
  abiertaEn        DateTime  @default(now()) @db.Timestamptz(3)
  cerradaEn        DateTime? @db.Timestamptz(3)
  notaCierre       String?

  // Relaciones inversas (navegación Prisma)
  pagoProveedoresComoTurnoCaja         PagoProveedor[]         @relation("PagoProveedor_turnoCaja_TurnoCaja")
  movimientoCajasComoTurno             MovimientoCaja[]        @relation("MovimientoCaja_turno_TurnoCaja")
  arqueoCajasComoTurno                 ArqueoCaja?             @relation("ArqueoCaja_turno_TurnoCaja")
  pagosComoTurno                       Pago[]                  @relation("Pago_turno_TurnoCaja")
  gastoOperativosComoTurno             GastoOperativo[]        @relation("GastoOperativo_turno_TurnoCaja")
  liquidacionRepartidoresComoTurnoCaja LiquidacionRepartidor[] @relation("LiquidacionRepartidor_turnoCaja_TurnoCaja")

  @@index([cajaId, cerradaEn])
  @@index([fechaOperativa])
}

model MovimientoCaja {
  id                      String                 @id @default(cuid())
  turnoId                 String
