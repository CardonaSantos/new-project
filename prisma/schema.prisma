// ============================================================================
// [S01] EMPRESA, SUCURSALES Y DISPOSITIVOS
// ============================================================================

model EmpresaConfiguracion {
  id               String           @id @default(cuid())
  nombreComercial  String
  razonSocial      String?
  nit              String?
  moneda           String           @default("GTQ") @db.VarChar(3)
  zonaHoraria      String           @default("America/Guatemala")
  metodoValoracion MetodoValoracion @default(PROMEDIO_PONDERADO)
  creadoEn         DateTime         @default(now()) @db.Timestamptz(3)
  actualizadoEn    DateTime         @updatedAt @db.Timestamptz(3)
}

model Sucursal {
  devolucionesProveedor DevolucionProveedor[]
  notasCreditoProveedor NotaCreditoProveedor[]
  id            String   @id @default(cuid())
  codigo        String   @unique
  nombre        String
  direccion     String?
  telefono      String?
  zonaHoraria   String   @default("America/Guatemala")
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  configuracionSucursalesComoSucursal     ConfiguracionSucursal?       @relation("ConfiguracionSucursal_sucursal_Sucursal")
  mediosComoSucursal Media[] @relation("Media_sucursal_Sucursal")
  dispositivosComoSucursal                Dispositivo[]                @relation("Dispositivo_sucursal_Sucursal")
  usuarioRolesComoSucursal                UsuarioRol[]                 @relation("UsuarioRol_sucursal_Sucursal")
  eventoAuditoriasComoSucursal            EventoAuditoria[]            @relation("EventoAuditoria_sucursal_Sucursal")
  precioVariantesComoSucursal             PrecioVariante[]             @relation("PrecioVariante_sucursal_Sucursal")
  reglaEmpaquesComoSucursal               ReglaEmpaque[]               @relation("ReglaEmpaque_sucursal_Sucursal")
  almacenesComoSucursal                   Almacen[]                    @relation("Almacen_sucursal_Sucursal")
  ordenComprasComoSucursal                OrdenCompra[]                @relation("OrdenCompra_sucursal_Sucursal")
  facturasProveedorComoSucursal           FacturaProveedor[]           @relation("FacturaProveedor_sucursal_Sucursal")
  salasComoSucursal                       Sala[]                       @relation("Sala_sucursal_Sucursal")
  ordenesComoSucursal                     Orden[]                      @relation("Orden_sucursal_Sucursal")
  estacionPreparacionesComoSucursal       EstacionPreparacion[]        @relation("EstacionPreparacion_sucursal_Sucursal")
  cajasComoSucursal                       Caja[]                       @relation("Caja_sucursal_Sucursal")
  configuracionProveedorPagosComoSucursal ConfiguracionProveedorPago[] @relation("ConfiguracionProveedorPago_sucursal_Sucursal")
  ventasComoSucursal                      Venta[]                      @relation("Venta_sucursal_Sucursal")
  cuentaFinancierasComoSucursal           CuentaFinanciera[]           @relation("CuentaFinanciera_sucursal_Sucursal")
  rutasFinancierasComoSucursal           RutaFinanciera[]             @relation("RutaFinanciera_sucursal_Sucursal")
  gastoOperativosComoSucursal             GastoOperativo[]             @relation("GastoOperativo_sucursal_Sucursal")
  cierreOperativosComoSucursal            CierreOperativo[]            @relation("CierreOperativo_sucursal_Sucursal")
  reversasFinancierasComoSucursal ReversaFinanciera[] @relation("ReversaFinanciera_sucursal_Sucursal")
  liquidacionRepartidoresComoSucursal     LiquidacionRepartidor[]      @relation("LiquidacionRepartidor_sucursal_Sucursal")
  reservasComoSucursal                    Reserva[]                    @relation("Reserva_sucursal_Sucursal")
  sesionAutoserviciosComoSucursal         SesionAutoservicio[]         @relation("SesionAutoservicio_sucursal_Sucursal")
  menusAsignados MenuSucursal[]
  variantesSucursal VarianteSucursal[]
  preciosModificador PrecioModificador[]
}

model ConfiguracionSucursal {
  id                      String   @id @default(cuid())
  sucursalId              String   @unique
  sucursal                Sucursal @relation("ConfiguracionSucursal_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  horaCorteOperativo      String   @default("04:00") @db.VarChar(5)
  exigeCobroAntesPreparar Boolean  @default(false)
  permiteStockNegativo    Boolean  @default(false)
  permiteOrdenesQR        Boolean  @default(false)
  moneda                  String   @default("GTQ") @db.VarChar(3)
  actualizadoEn           DateTime @updatedAt @db.Timestamptz(3)
}

model Dispositivo {
  id                    String               @id @default(cuid())
  sucursalId            String
  sucursal              Sucursal             @relation("Dispositivo_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  codigo                String
  nombre                String
  tipo                  TipoDispositivo
  estacionPreparacionId String?
  estacionPreparacion   EstacionPreparacion? @relation("Dispositivo_estacionPreparacion_EstacionPreparacion", fields: [estacionPreparacionId], references: [id], onDelete: SetNull)
  ultimoAccesoEn        DateTime?            @db.Timestamptz(3)
  activo                Boolean              @default(true)
  creadoEn              DateTime             @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  sesionUsuariosComoDispositivo      SesionUsuario[]      @relation("SesionUsuario_dispositivo_Dispositivo")
  sesionAutoserviciosComoDispositivo SesionAutoservicio[] @relation("SesionAutoservicio_dispositivo_Dispositivo")

  @@unique([sucursalId, codigo])
}

// ============================================================================
// [S02] IDENTIDAD, ROLES, PERMISOS Y AUDITORÍA
// ============================================================================

model Usuario {
  id                  String    @id @default(cuid())
  email               String    @unique
  nombre              String
  hashContrasena      String
  activo              Boolean   @default(true)
  versionAutorizacion Int       @default(1)
  debeCambiarContrasena Boolean @default(false)
  contrasenaCambiadaEn DateTime? @db.Timestamptz(3)
  ultimoAccesoEn      DateTime? @db.Timestamptz(3)
  creadoEn            DateTime  @default(now()) @db.Timestamptz(3)
  actualizadoEn       DateTime  @updatedAt @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  sesionUsuariosComoUsuario             SesionUsuario[]           @relation("SesionUsuario_usuario_Usuario")
  usuarioRolesComoUsuario               UsuarioRol[]              @relation("UsuarioRol_usuario_Usuario")
  eventoAuditoriasComoUsuario           EventoAuditoria[]         @relation("EventoAuditoria_usuario_Usuario")
  movimientoInventariosComoUsuario      MovimientoInventario[]    @relation("MovimientoInventario_usuario_Usuario")
  conteoInventariosComoUsuario          ConteoInventario[]        @relation("ConteoInventario_usuario_Usuario")
  ajusteInventariosComoUsuario          AjusteInventario[]        @relation("AjusteInventario_usuario_Usuario")
  produccionLotesComoUsuario            ProduccionLote[]          @relation("ProduccionLote_usuario_Usuario")
  ordenComprasComoUsuario               OrdenCompra[]             @relation("OrdenCompra_usuario_Usuario")
  recepcionesCompraComoUsuario          RecepcionCompra[]         @relation("RecepcionCompra_usuario_Usuario")
  pagoProveedoresComoUsuario            PagoProveedor[]           @relation("PagoProveedor_usuario_Usuario")
  requisicionesComoSolicitante          Requisicion[]             @relation("Requisicion_solicitante_Usuario")
  transferenciaInventariosComoUsuario   TransferenciaInventario[] @relation("TransferenciaInventario_usuario_Usuario")
  ocupacionMesasComoAbiertaPor          OcupacionMesa[]           @relation("OcupacionMesa_abiertaPor_Usuario")
  ordenesComoUsuario                    Orden[]                   @relation("Orden_usuario_Usuario")
  eventoOrdenesComoUsuario              EventoOrden[]             @relation("EventoOrden_usuario_Usuario")
  eventoComandasComoUsuario             EventoComanda[]           @relation("EventoComanda_usuario_Usuario")
  turnoCajasComoCajero                  TurnoCaja[]               @relation("TurnoCaja_cajero_Usuario")
  movimientoCajasComoUsuario            MovimientoCaja[]          @relation("MovimientoCaja_usuario_Usuario")
  arqueoCajasComoRealizadoPor           ArqueoCaja[]              @relation("ArqueoCaja_realizadoPor_Usuario")
  pagosComoCobradoPor                   Pago[]                    @relation("Pago_cobradoPor_Usuario")
  reembolsoPagosComoUsuario             ReembolsoPago[]           @relation("ReembolsoPago_usuario_Usuario")
  gastoOperativosComoUsuario            GastoOperativo[]          @relation("GastoOperativo_usuario_Usuario")
  cierreOperativosComoUsuario           CierreOperativo[]         @relation("CierreOperativo_usuario_Usuario")
  entregasComoRepartidor                Entrega[]                 @relation("Entrega_repartidor_Usuario")
  liquidacionRepartidoresComoRepartidor LiquidacionRepartidor[]   @relation("LiquidacionRepartidor_repartidor_Usuario")
  reservasComoCreadaPor                 Reserva[]                 @relation("Reserva_creadaPor_Usuario")
  eventoReservasComoUsuario             EventoReserva[]           @relation("EventoReserva_usuario_Usuario")

  perfil PerfilUsuario? @relation("PerfilUsuario_usuario_Usuario")
  mediosSubidos Media[] @relation("Media_subidaPor_Usuario")
  lineasExtractoImportadas LineaExtractoBancario[] @relation("LineaExtracto_importador_Usuario")
  lineasExtractoConciliadas LineaExtractoBancario[] @relation("LineaExtracto_conciliador_Usuario")
  reversasFinancierasComoUsuario ReversaFinanciera[] @relation("ReversaFinanciera_usuario_Usuario")
}

model SesionUsuario {
  id               String       @id @default(cuid())
  usuarioId        String
  usuario          Usuario      @relation("SesionUsuario_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  hashRefreshToken String       @unique
  dispositivoId    String?
  dispositivo      Dispositivo? @relation("SesionUsuario_dispositivo_Dispositivo", fields: [dispositivoId], references: [id], onDelete: SetNull)
  expiraEn         DateTime     @db.Timestamptz(3)
  ultimoUsoEn DateTime? @db.Timestamptz(3)
  revocacionMotivo String?
  userAgent String?
  ipCreacion String?
  revocadaEn       DateTime?    @db.Timestamptz(3)
  creadaEn         DateTime     @default(now()) @db.Timestamptz(3)

  @@index([usuarioId, revocadaEn])
}

model Rol {
  id          String   @id @default(cuid())
  alcance     AlcanceRol @default(SUCURSAL)
  codigo      String   @unique
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  version     Int      @default(1)
  creadoEn    DateTime @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  rolPermisosComoRol  RolPermiso[] @relation("RolPermiso_rol_Rol")
  usuarioRolesComoRol UsuarioRol[] @relation("UsuarioRol_rol_Rol")
}

model Permiso {
  id          String  @id @default(cuid())
  codigo      String  @unique
  descripcion String?
  modulo      String

  // Relaciones inversas (navegación Prisma)
  rolPermisosComoPermiso RolPermiso[] @relation("RolPermiso_permiso_Permiso")
}

model RolPermiso {
  id        String  @id @default(cuid())
  rolId     String
  rol       Rol     @relation("RolPermiso_rol_Rol", fields: [rolId], references: [id], onDelete: Cascade)
  permisoId String
  permiso   Permiso @relation("RolPermiso_permiso_Permiso", fields: [permisoId], references: [id], onDelete: Cascade)

  @@unique([rolId, permisoId])
}

model UsuarioRol {
  id         String   @id @default(cuid())
  usuarioId  String
  usuario    Usuario  @relation("UsuarioRol_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  rolId      String
  rol        Rol      @relation("UsuarioRol_rol_Rol", fields: [rolId], references: [id], onDelete: Restrict)
  sucursalId String?
  sucursal   Sucursal? @relation("UsuarioRol_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  creadoEn   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([usuarioId, rolId, sucursalId])
  @@index([sucursalId, usuarioId])
}

model EventoAuditoria {
  id         String    @id @default(cuid())
  usuarioId  String?
  usuario    Usuario?  @relation("EventoAuditoria_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  sucursalId String?
  sucursal   Sucursal? @relation("EventoAuditoria_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: SetNull)
  accion     String
  entidad    String
  entidadId  String?
  antes      Json?
  despues    Json?
  ip         String?
  motivo     String?
  creadoEn   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([entidad, entidadId, creadoEn])
  @@index([usuarioId, creadoEn])
}

// ============================================================================
// [S03] CATÁLOGO COMERCIAL, VARIANTES Y MODIFICADORES
// ============================================================================

model Categoria {
  id       String     @id @default(cuid())
  nombre   String
  parentId String?
  parent   Categoria? @relation("Categoria_parent_Categoria", fields: [parentId], references: [id], onDelete: SetNull)
  orden    Int        @default(0)
  activa   Boolean    @default(true)

  // Relaciones inversas (navegación Prisma)
  categoriasComoParent           Categoria[]       @relation("Categoria_parent_Categoria")
  productosComoCategoria         Producto[]        @relation("Producto_categoria_Categoria")
  rutaPreparacionesComoCategoria RutaPreparacion[] @relation("RutaPreparacion_categoria_Categoria")

  medios CategoriaMedia[] @relation("CategoriaMedia_categoria_Categoria")
}

model Producto {
  id            String       @id @default(cuid())
  codigo        String       @unique
  categoriaId   String?
  categoria     Categoria?   @relation("Producto_categoria_Categoria", fields: [categoriaId], references: [id], onDelete: SetNull)
  nombre        String
  descripcion   String?
  tipo          TipoProducto @default(PREPARADO)
  activo        Boolean      @default(true)
  visibleEnMenu Boolean @default(false)
  creadoEn      DateTime     @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime     @updatedAt @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  varianteProductosComoProducto VarianteProducto[] @relation("VarianteProducto_producto_Producto")

  medios ProductoMedia[] @relation("ProductoMedia_producto_Producto")
}

model VarianteProducto {
  id                   String              @id @default(cuid())
  productoId           String
  producto             Producto            @relation("VarianteProducto_producto_Producto", fields: [productoId], references: [id], onDelete: Restrict)
  articuloInventarioId String?
  articuloInventario   ArticuloInventario? @relation("VarianteProducto_articuloInventario_ArticuloInventario", fields: [articuloInventarioId], references: [id], onDelete: Restrict)
  // Si Producto.tipo=INVENTARIABLE, cada variante apunta a su SKU físico.
  sku                  String?             @unique
  nombre               String
  orden                Int                 @default(0)
  activo               Boolean             @default(true)

  // Relaciones inversas (navegación Prisma)
  precioVariantesComoVariante            PrecioVariante[]           @relation("PrecioVariante_variante_VarianteProducto")
  varianteGrupoModificadoresComoVariante VarianteGrupoModificador[] @relation("VarianteGrupoModificador_variante_VarianteProducto")
  recetasComoVariante                    Receta[]                   @relation("Receta_variante_VarianteProducto")
  reglaEmpaquesComoVariante              ReglaEmpaque[]             @relation("ReglaEmpaque_variante_VarianteProducto")
  ordenLineasComoVariante                OrdenLinea[]               @relation("OrdenLinea_variante_VarianteProducto")
  rutaPreparacionesComoVariante          RutaPreparacion[]          @relation("RutaPreparacion_variante_VarianteProducto")

  @@unique([productoId, nombre])

  medios VarianteProductoMedia[] @relation("VarianteProductoMedia_variante_VarianteProducto")
  itemsMenu MenuItem[]
  configuracionesSucursal VarianteSucursal[]
}

model PrecioVariante {
  id           String           @id @default(cuid())
  varianteId   String
  variante     VarianteProducto @relation("PrecioVariante_variante_VarianteProducto", fields: [varianteId], references: [id], onDelete: Restrict)
  sucursalId   String
  sucursal     Sucursal         @relation("PrecioVariante_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  importe      Decimal          @db.Decimal(18, 2)
  vigenteDesde DateTime         @default(now()) @db.Timestamptz(3)
  vigenteHasta DateTime?        @db.Timestamptz(3)

  @@index([varianteId, sucursalId, vigenteDesde])
}

model GrupoModificador {
  id     String  @id @default(cuid())
  nombre String
  minimo Int     @default(0)
  maximo Int?
  activo Boolean @default(true)

  // Relaciones inversas (navegación Prisma)
  modificadoresComoGrupo              Modificador[]              @relation("Modificador_grupo_GrupoModificador")
  varianteGrupoModificadoresComoGrupo VarianteGrupoModificador[] @relation("VarianteGrupoModificador_grupo_GrupoModificador")
}

model Modificador {
  id               String           @id @default(cuid())
  grupoId          String
  grupo            GrupoModificador @relation("Modificador_grupo_GrupoModificador", fields: [grupoId], references: [id], onDelete: Restrict)
  nombre           String
  incrementoPrecio Decimal          @default(0) @db.Decimal(18, 2)
  requiereComposicion Boolean        @default(false)
  activo           Boolean          @default(true)

  // Relaciones inversas (navegación Prisma)
  modificadorComponentesComoModificador  ModificadorComponente[] @relation("ModificadorComponente_modificador_Modificador")
  ordenLineaModificadoresComoModificador OrdenLineaModificador[] @relation("OrdenLineaModificador_modificador_Modificador")

  @@unique([grupoId, nombre])
  preciosSucursal PrecioModificador[]
}

model VarianteGrupoModificador {
  id          String           @id @default(cuid())
  varianteId  String
  variante    VarianteProducto @relation("VarianteGrupoModificador_variante_VarianteProducto", fields: [varianteId], references: [id], onDelete: Cascade)
  grupoId     String
  grupo       GrupoModificador @relation("VarianteGrupoModificador_grupo_GrupoModificador", fields: [grupoId], references: [id], onDelete: Restrict)
  orden       Int              @default(0)
  obligatorio Boolean          @default(false)

  @@unique([varianteId, grupoId])
}

// ============================================================================
// [S04] ARTÍCULOS, UNIDADES, RECETAS Y EMPAQUES
// ============================================================================

model UnidadMedida {
  id        String          @id @default(cuid())
  codigo    String          @unique
  nombre    String
  dimension UnidadDimension
  esBase    Boolean         @default(false)

  // Relaciones inversas (navegación Prisma)
  conversionUnidadesComoUnidadOrigen   ConversionUnidad[]      @relation("ConversionUnidad_unidadOrigen_UnidadMedida")
  conversionUnidadesComoUnidadDestino  ConversionUnidad[]      @relation("ConversionUnidad_unidadDestino_UnidadMedida")
  articulosInventarioComoUnidadBase    ArticuloInventario[]    @relation("ArticuloInventario_unidadBase_UnidadMedida")
  recetaVersionesComoUnidadRendimiento RecetaVersion[]         @relation("RecetaVersion_unidadRendimiento_UnidadMedida")
  recetaComponentesComoUnidad          RecetaComponente[]      @relation("RecetaComponente_unidad_UnidadMedida")
  modificadorComponentesComoUnidad     ModificadorComponente[] @relation("ModificadorComponente_unidad_UnidadMedida")
  presentacionComprasComoUnidadCompra  PresentacionCompra[]    @relation("PresentacionCompra_unidadCompra_UnidadMedida")
}

model ConversionUnidad {
  id              String       @id @default(cuid())
  unidadOrigenId  String
  unidadOrigen    UnidadMedida @relation("ConversionUnidad_unidadOrigen_UnidadMedida", fields: [unidadOrigenId], references: [id], onDelete: Restrict)
  unidadDestinoId String
  unidadDestino   UnidadMedida @relation("ConversionUnidad_unidadDestino_UnidadMedida", fields: [unidadDestinoId], references: [id], onDelete: Restrict)
  factor          Decimal      @db.Decimal(24, 10)

  @@unique([unidadOrigenId, unidadDestinoId])
}

model ArticuloInventario {
  id                  String       @id @default(cuid())
  codigo              String       @unique
  nombre              String
  tipo                TipoArticulo
  unidadBaseId        String
  unidadBase          UnidadMedida @relation("ArticuloInventario_unidadBase_UnidadMedida", fields: [unidadBaseId], references: [id], onDelete: Restrict)
  requiereLote        Boolean      @default(false)
  requiereVencimiento Boolean      @default(false)
  costoReferencia     Decimal?     @db.Decimal(18, 6)
  stockMinimo         Decimal?     @db.Decimal(20, 6)
  activo              Boolean      @default(true)
  creadoEn            DateTime     @default(now()) @db.Timestamptz(3)
  actualizadoEn       DateTime     @updatedAt @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  varianteProductosComoArticuloInventario     VarianteProducto[]             @relation("VarianteProducto_articuloInventario_ArticuloInventario")
  recetasComoArticuloResultado                Receta[]                       @relation("Receta_articuloResultado_ArticuloInventario")
  recetaComponentesComoArticulo               RecetaComponente[]             @relation("RecetaComponente_articulo_ArticuloInventario")
  modificadorComponentesComoArticulo          ModificadorComponente[]        @relation("ModificadorComponente_articulo_ArticuloInventario")
  modificadorComponentesComoSustituyeArticulo ModificadorComponente[]        @relation("ModificadorComponente_sustituyeArticulo_ArticuloInventario")
  reglaEmpaqueLineasComoArticulo              ReglaEmpaqueLinea[]            @relation("ReglaEmpaqueLinea_articulo_ArticuloInventario")
  loteInventariosComoArticulo                 LoteInventario[]               @relation("LoteInventario_articulo_ArticuloInventario")
  existenciasComoArticulo                     Existencia[]                   @relation("Existencia_articulo_ArticuloInventario")
  movimientoInventariosComoArticulo           MovimientoInventario[]         @relation("MovimientoInventario_articulo_ArticuloInventario")
  capaCostoInventariosComoArticulo            CapaCostoInventario[]          @relation("CapaCostoInventario_articulo_ArticuloInventario")
  conteoInventarioLineasComoArticulo          ConteoInventarioLinea[]        @relation("ConteoInventarioLinea_articulo_ArticuloInventario")
  ajusteInventarioLineasComoArticulo          AjusteInventarioLinea[]        @relation("AjusteInventarioLinea_articulo_ArticuloInventario")
  produccionConsumosComoArticulo              ProduccionConsumo[]            @relation("ProduccionConsumo_articulo_ArticuloInventario")
  consumoOrdenLineasComoArticulo              ConsumoOrdenLinea[]            @relation("ConsumoOrdenLinea_articulo_ArticuloInventario")
  presentacionComprasComoArticulo             PresentacionCompra[]           @relation("PresentacionCompra_articulo_ArticuloInventario")
  ordenCompraLineasComoArticulo               OrdenCompraLinea[]             @relation("OrdenCompraLinea_articulo_ArticuloInventario")
  recepcionCompraLineasComoArticulo           RecepcionCompraLinea[]         @relation("RecepcionCompraLinea_articulo_ArticuloInventario")
  facturaProveedorLineasComoArticulo          FacturaProveedorLinea[]        @relation("FacturaProveedorLinea_articulo_ArticuloInventario")
  requisicionLineasComoArticulo               RequisicionLinea[]             @relation("RequisicionLinea_articulo_ArticuloInventario")
  transferenciaInventarioLineasComoArticulo   TransferenciaInventarioLinea[] @relation("TransferenciaInventarioLinea_articulo_ArticuloInventario")

  medios ArticuloInventarioMedia[] @relation("ArticuloInventarioMedia_articulo_ArticuloInventario")
}

model Receta {
  id                  String              @id @default(cuid())
  nombre              String
  tipo                TipoReceta
  varianteId          String?
  variante            VarianteProducto?   @relation("Receta_variante_VarianteProducto", fields: [varianteId], references: [id], onDelete: Restrict)
  articuloResultadoId String?
  articuloResultado   ArticuloInventario? @relation("Receta_articuloResultado_ArticuloInventario", fields: [articuloResultadoId], references: [id], onDelete: Restrict)
  activa              Boolean             @default(true)
  // Para VENTA usar varianteId; para PRODUCCION usar articuloResultadoId.

  // Relaciones inversas (navegación Prisma)
  recetaVersionesComoReceta RecetaVersion[] @relation("RecetaVersion_receta_Receta")
}

model RecetaVersion {
  id                  String       @id @default(cuid())
  recetaId            String
  receta              Receta       @relation("RecetaVersion_receta_Receta", fields: [recetaId], references: [id], onDelete: Restrict)
  numero              Int
  rendimiento         Decimal      @default(1) @db.Decimal(20, 6)
  unidadRendimientoId String
  unidadRendimiento   UnidadMedida @relation("RecetaVersion_unidadRendimiento_UnidadMedida", fields: [unidadRendimientoId], references: [id], onDelete: Restrict)
  publicadaEn         DateTime?    @db.Timestamptz(3)
  activa              Boolean      @default(false)
  creadaEn            DateTime     @default(now()) @db.Timestamptz(3)
  vidaUtilDias        Int?

  // Relaciones inversas (navegación Prisma)
  recetaComponentesComoRecetaVersion RecetaComponente[] @relation("RecetaComponente_recetaVersion_RecetaVersion")
  produccionLotesComoRecetaVersion   ProduccionLote[]   @relation("ProduccionLote_recetaVersion_RecetaVersion")
  consumoOrdenesComoRecetaVersion    ConsumoOrden[]     @relation("ConsumoOrden_recetaVersion_RecetaVersion")
  ordenLineasComoVersion              OrdenLinea[]      @relation("OrdenLinea_version_RecetaVersion")

  @@unique([recetaId, numero])
}

model RecetaComponente {
  id              String             @id @default(cuid())
  recetaVersionId String
  recetaVersion   RecetaVersion      @relation("RecetaComponente_recetaVersion_RecetaVersion", fields: [recetaVersionId], references: [id], onDelete: Restrict)
  articuloId      String
  articulo        ArticuloInventario @relation("RecetaComponente_articulo_ArticuloInventario", fields: [articuloId], references: [id], onDelete: Restrict)
  cantidad        Decimal            @db.Decimal(20, 6)
  unidadId        String
  unidad          UnidadMedida       @relation("RecetaComponente_unidad_UnidadMedida", fields: [unidadId], references: [id], onDelete: Restrict)
  mermaPorcentaje Decimal            @default(0) @db.Decimal(7, 4)

  @@unique([recetaVersionId, articuloId])
}

model ModificadorComponente {
  id                  String              @id @default(cuid())
  modificadorId       String
  modificador         Modificador         @relation("ModificadorComponente_modificador_Modificador", fields: [modificadorId], references: [id], onDelete: Restrict)
  articuloId          String
  articulo            ArticuloInventario  @relation("ModificadorComponente_articulo_ArticuloInventario", fields: [articuloId], references: [id], onDelete: Restrict)
  efecto              EfectoModificador
  cantidad            Decimal             @db.Decimal(20, 6)
  unidadId            String
  unidad              UnidadMedida        @relation("ModificadorComponente_unidad_UnidadMedida", fields: [unidadId], references: [id], onDelete: Restrict)
  sustituyeArticuloId String?
  sustituyeArticulo   ArticuloInventario? @relation("ModificadorComponente_sustituyeArticulo_ArticuloInventario", fields: [sustituyeArticuloId], references: [id], onDelete: Restrict)

  @@index([modificadorId])
}

model ReglaEmpaque {
  id         String            @id @default(cuid())
  nombre     String
  alcance    AlcanceEmpaque
  modalidad  ModalidadServicio
  varianteId String?
  variante   VarianteProducto? @relation("ReglaEmpaque_variante_VarianteProducto", fields: [varianteId], references: [id], onDelete: Restrict)
  sucursalId String?
  sucursal   Sucursal?         @relation("ReglaEmpaque_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  activa     Boolean           @default(true)

  // Relaciones inversas (navegación Prisma)
  reglaEmpaqueLineasComoRegla ReglaEmpaqueLinea[] @relation("ReglaEmpaqueLinea_regla_ReglaEmpaque")
}

model ReglaEmpaqueLinea {
  id         String             @id @default(cuid())
  reglaId    String
  regla      ReglaEmpaque       @relation("ReglaEmpaqueLinea_regla_ReglaEmpaque", fields: [reglaId], references: [id], onDelete: Cascade)
  articuloId String
  articulo   ArticuloInventario @relation("ReglaEmpaqueLinea_articulo_ArticuloInventario", fields: [articuloId], references: [id], onDelete: Restrict)
  cantidad   Decimal            @db.Decimal(20, 6)

  @@unique([reglaId, articuloId])
}

// ============================================================================
// [S05] ALMACENES, LOTES, KARDEX Y CONTEOS
// ============================================================================

model Almacen {
  devolucionesProveedor DevolucionProveedor[]
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation("Almacen_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  codigo     String
  nombre     String
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  ubicacionAlmacenesComoAlmacen              UbicacionAlmacen[]        @relation("UbicacionAlmacen_almacen_Almacen")
  conteoInventariosComoAlmacen               ConteoInventario[]        @relation("ConteoInventario_almacen_Almacen")
  ajusteInventariosComoAlmacen               AjusteInventario[]        @relation("AjusteInventario_almacen_Almacen")
  recepcionesCompraComoAlmacen               RecepcionCompra[]         @relation("RecepcionCompra_almacen_Almacen")
  requisicionesComoAlmacenDestino            Requisicion[]             @relation("Requisicion_almacenDestino_Almacen")
  transferenciaInventariosComoAlmacenOrigen  TransferenciaInventario[] @relation("TransferenciaInventario_almacenOrigen_Almacen")
  transferenciaInventariosComoAlmacenDestino TransferenciaInventario[] @relation("TransferenciaInventario_almacenDestino_Almacen")

  @@unique([sucursalId, codigo])
}

model UbicacionAlmacen {
  id          String  @id @default(cuid())
  almacenId   String
  almacen     Almacen @relation("UbicacionAlmacen_almacen_Almacen", fields: [almacenId], references: [id], onDelete: Restrict)
  codigo      String
  nombre      String
  esRecepcion Boolean @default(false)
  activa      Boolean @default(true)

  // Relaciones inversas (navegación Prisma)
  existenciasComoUbicacion                          Existencia[]                   @relation("Existencia_ubicacion_UbicacionAlmacen")
  movimientoInventariosComoUbicacion                MovimientoInventario[]         @relation("MovimientoInventario_ubicacion_UbicacionAlmacen")
  capaCostoInventariosComoUbicacion                 CapaCostoInventario[]          @relation("CapaCostoInventario_ubicacion_UbicacionAlmacen")
  conteoInventarioLineasComoUbicacion               ConteoInventarioLinea[]        @relation("ConteoInventarioLinea_ubicacion_UbicacionAlmacen")
  ajusteInventarioLineasComoUbicacion               AjusteInventarioLinea[]        @relation("AjusteInventarioLinea_ubicacion_UbicacionAlmacen")
  produccionLotesComoUbicacionDestino               ProduccionLote[]               @relation("ProduccionLote_ubicacionDestino_UbicacionAlmacen")
  produccionConsumosComoUbicacion                   ProduccionConsumo[]            @relation("ProduccionConsumo_ubicacion_UbicacionAlmacen")
  consumoOrdenLineasComoUbicacion                   ConsumoOrdenLinea[]            @relation("ConsumoOrdenLinea_ubicacion_UbicacionAlmacen")
  recepcionCompraLineasComoUbicacion                RecepcionCompraLinea[]         @relation("RecepcionCompraLinea_ubicacion_UbicacionAlmacen")
  transferenciaInventarioLineasComoUbicacionOrigen  TransferenciaInventarioLinea[] @relation("TransferenciaInventarioLinea_ubicacionOrigen_UbicacionAlmacen")
  transferenciaInventarioLineasComoUbicacionDestino TransferenciaInventarioLinea[] @relation("TransferenciaInventarioLinea_ubicacionDestino_UbicacionAlmacen")
  estacionPreparacionesComoUbicacionConsumo         EstacionPreparacion[]          @relation("EstacionPreparacion_ubicacionConsumo_UbicacionAlmacen")

  @@unique([almacenId, codigo])
}

model LoteInventario {
  id               String             @id @default(cuid())
  articuloId       String
  articulo         ArticuloInventario @relation("LoteInventario_articulo_ArticuloInventario", fields: [articuloId], references: [id], onDelete: Restrict)
  codigoLote       String
  fechaElaboracion DateTime?          @db.Date
  fechaVencimiento DateTime?          @db.Date
  costoOrigen      Decimal?           @db.Decimal(18, 6)
  bloqueado        Boolean            @default(false) // Retención, contaminación o cuarentena.
  creadoEn         DateTime           @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  existenciasComoLote                   Existencia[]                   @relation("Existencia_lote_LoteInventario")
  movimientoInventariosComoLote         MovimientoInventario[]         @relation("MovimientoInventario_lote_LoteInventario")
  conteoInventarioLineasComoLote        ConteoInventarioLinea[]        @relation("ConteoInventarioLinea_lote_LoteInventario")
  ajusteInventarioLineasComoLote        AjusteInventarioLinea[]        @relation("AjusteInventarioLinea_lote_LoteInventario")
  produccionLotesComoLoteResultado      ProduccionLote[]               @relation("ProduccionLote_loteResultado_LoteInventario")
  produccionConsumosComoLote            ProduccionConsumo[]            @relation("ProduccionConsumo_lote_LoteInventario")
  consumoOrdenLineasComoLote            ConsumoOrdenLinea[]            @relation("ConsumoOrdenLinea_lote_LoteInventario")
  recepcionCompraLineasComoLote         RecepcionCompraLinea[]         @relation("RecepcionCompraLinea_lote_LoteInventario")
  transferenciaInventarioLineasComoLote TransferenciaInventarioLinea[] @relation("TransferenciaInventarioLinea_lote_LoteInventario")

  @@unique([articuloId, codigoLote])
  @@index([fechaVencimiento])
}

model Existencia {
  id            String             @id @default(cuid())
  articuloId    String
  articulo      ArticuloInventario @relation("Existencia_articulo_ArticuloInventario", fields: [articuloId], references: [id], onDelete: Restrict)
  ubicacionId   String
  ubicacion     UbicacionAlmacen   @relation("Existencia_ubicacion_UbicacionAlmacen", fields: [ubicacionId], references: [id], onDelete: Restrict)
  loteId        String?
  lote          LoteInventario?    @relation("Existencia_lote_LoteInventario", fields: [loteId], references: [id], onDelete: Restrict)
  cantidad      Decimal            @default(0) @db.Decimal(20, 6)
  costoPromedio Decimal            @default(0) @db.Decimal(18, 6)
  actualizadoEn DateTime           @updatedAt @db.Timestamptz(3)
  // IMPORTANTE: unique parcial para lote NULL; ver README técnico.

  @@unique([articuloId, ubicacionId, loteId])
  @@index([ubicacionId, articuloId])
}

model MovimientoInventario {
  id             String                   @id @default(cuid())
  articuloId     String
  articulo       ArticuloInventario       @relation("MovimientoInventario_articulo_ArticuloInventario", fields: [articuloId], references: [id], onDelete: Restrict)
  ubicacionId    String
  ubicacion      UbicacionAlmacen         @relation("MovimientoInventario_ubicacion_UbicacionAlmacen", fields: [ubicacionId], references: [id], onDelete: Restrict)
  loteId         String?
  lote           LoteInventario?          @relation("MovimientoInventario_lote_LoteInventario", fields: [loteId], references: [id], onDelete: Restrict)
  tipo           TipoMovimientoInventario
  cantidad       Decimal                  @db.Decimal(20, 6) // firmada: + entrada / - salida
  costoUnitario  Decimal                  @db.Decimal(18, 6)
  costoTotal     Decimal                  @db.Decimal(20, 6)
  referenciaTipo String
  referenciaId   String
  claveOperacion String                   @unique
  nota           String?
  usuarioId      String?
  usuario        Usuario?                 @relation("MovimientoInventario_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  creadoEn       DateTime                 @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  capaCostoInventariosComoMovimientoEntrada CapaCostoInventario?  @relation("CapaCostoInventario_movimientoEntrada_MovimientoInventario")
  aplicacionCapaCostosComoMovimientoSalida  AplicacionCapaCosto[] @relation("AplicacionCapaCosto_movimientoSalida_MovimientoInventario")
  produccionConsumosComoMovimiento          ProduccionConsumo?    @relation("ProduccionConsumo_movimiento_MovimientoInventario")
  produccionResultadoComoMovimiento          ProduccionLote?       @relation("ProduccionResultado_movimiento")
  consumoOrdenLineasComoMovimiento          ConsumoOrdenLinea?    @relation("ConsumoOrdenLinea_movimiento_MovimientoInventario")

  @@index([articuloId, creadoEn])
  @@index([ubicacionId, creadoEn])
  @@index([referenciaTipo, referenciaId])
}

model CapaCostoInventario {
  id                  String               @id @default(cuid())
  movimientoEntradaId String               @unique
  movimientoEntrada   MovimientoInventario @relation("CapaCostoInventario_movimientoEntrada_MovimientoInventario", fields: [movimientoEntradaId], references: [id], onDelete: Restrict)
  articuloId          String
  articulo            ArticuloInventario   @relation("CapaCostoInventario_articulo_ArticuloInventario", fields: [articuloId], references: [id], onDelete: Restrict)
  ubicacionId         String
  ubicacion           UbicacionAlmacen     @relation("CapaCostoInventario_ubicacion_UbicacionAlmacen", fields: [ubicacionId], references: [id], onDelete: Restrict)
  cantidadInicial     Decimal              @db.Decimal(20, 6)
  cantidadRestante    Decimal              @db.Decimal(20, 6)
  costoUnitario       Decimal              @db.Decimal(18, 6)
  creadoEn            DateTime             @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  aplicacionCapaCostosComoCapa AplicacionCapaCosto[] @relation("AplicacionCapaCosto_capa_CapaCostoInventario")

  @@index([articuloId, ubicacionId, creadoEn])
}

model AplicacionCapaCosto {
  id                 String               @id @default(cuid())
  capaId             String
  capa               CapaCostoInventario  @relation("AplicacionCapaCosto_capa_CapaCostoInventario", fields: [capaId], references: [id], onDelete: Restrict)
  movimientoSalidaId String
  movimientoSalida   MovimientoInventario @relation("AplicacionCapaCosto_movimientoSalida_MovimientoInventario", fields: [movimientoSalidaId], references: [id], onDelete: Restrict)
  cantidad           Decimal              @db.Decimal(20, 6)
  costoUnitario      Decimal              @db.Decimal(18, 6)

  @@unique([capaId, movimientoSalidaId])
}

model ConteoInventario {
  id           String          @id @default(cuid())
  almacenId    String
  almacen      Almacen         @relation("ConteoInventario_almacen_Almacen", fields: [almacenId], references: [id], onDelete: Restrict)
  usuarioId    String
  usuario      Usuario         @relation("ConteoInventario_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  estado       EstadoDocumento @default(BORRADOR)
  nota         String?
  confirmadoEn DateTime?       @db.Timestamptz(3)
  creadoEn     DateTime        @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  conteoInventarioLineasComoConteo ConteoInventarioLinea[] @relation("ConteoInventarioLinea_conteo_ConteoInventario")
  ajusteInventariosComoConteo      AjusteInventario?       @relation("AjusteInventario_conteo_ConteoInventario")
}

model ConteoInventarioLinea {
  id              String             @id @default(cuid())
  conteoId        String
  conteo          ConteoInventario   @relation("ConteoInventarioLinea_conteo_ConteoInventario", fields: [conteoId], references: [id], onDelete: Restrict)
  articuloId      String
  articulo        ArticuloInventario @relation("ConteoInventarioLinea_articulo_ArticuloInventario", fields: [articuloId], references: [id], onDelete: Restrict)
  ubicacionId     String
  ubicacion       UbicacionAlmacen   @relation("ConteoInventarioLinea_ubicacion_UbicacionAlmacen", fields: [ubicacionId], references: [id], onDelete: Restrict)
  loteId          String?
  lote            LoteInventario?    @relation("ConteoInventarioLinea_lote_LoteInventario", fields: [loteId], references: [id], onDelete: Restrict)
  cantidadTeorica Decimal            @db.Decimal(20, 6)
  cantidadContada Decimal            @db.Decimal(20, 6)
  costoUnitarioEntrada Decimal?       @db.Decimal(18, 6)
  // Una línea de diferencia genera un movimiento al confirmar.

  @@index([conteoId, articuloId])
}

model AjusteInventario {
  id           String            @id @default(cuid())
  almacenId    String
  almacen      Almacen           @relation("AjusteInventario_almacen_Almacen", fields: [almacenId], references: [id], onDelete: Restrict)
  conteoId     String?           @unique
  conteo       ConteoInventario? @relation("AjusteInventario_conteo_ConteoInventario", fields: [conteoId], references: [id], onDelete: SetNull)
  usuarioId    String
  usuario      Usuario           @relation("AjusteInventario_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  motivo       String
  estado       EstadoDocumento   @default(BORRADOR)
  confirmadoEn DateTime?         @db.Timestamptz(3)
  creadoEn     DateTime          @default(now()) @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
