  turnoCajaId    String?
  turnoCaja      TurnoCaja?        @relation("LiquidacionRepartidor_turnoCaja_TurnoCaja", fields: [turnoCajaId], references: [id], onDelete: Restrict)
  estado         EstadoLiquidacion @default(ABIERTA)
  totalEsperado  Decimal           @default(0) @db.Decimal(18, 2)
  totalEntregado Decimal           @default(0) @db.Decimal(18, 2)
  creadaEn       DateTime          @default(now()) @db.Timestamptz(3)
  cerradaEn      DateTime?         @db.Timestamptz(3)

  // Relaciones inversas (navegación Prisma)
  movimientoCajasComoLiquidacionRepartidor   MovimientoCaja?              @relation("MovimientoCaja_liquidacionRepartidor_LiquidacionRepartidor")
  liquidacionRepartidorLineasComoLiquidacion LiquidacionRepartidorLinea[] @relation("LiquidacionRepartidorLinea_liquidacion_LiquidacionRepartidor")
}

model LiquidacionRepartidorLinea {
