  tipo                    TipoMovimientoCaja
  monto                   Decimal                @db.Decimal(18, 2)
  motivo                  String
  pagoId                  String?                @unique
  pago                    Pago?                  @relation("MovimientoCaja_pago_Pago", fields: [pagoId], references: [id], onDelete: Restrict)
  reembolsoId             String?                @unique
  reembolso               ReembolsoPago?         @relation("MovimientoCaja_reembolso_ReembolsoPago", fields: [reembolsoId], references: [id], onDelete: Restrict)
  gastoId                 String?                @unique
  gasto                   GastoOperativo?        @relation("MovimientoCaja_gasto_GastoOperativo", fields: [gastoId], references: [id], onDelete: Restrict)
  pagoProveedorId         String?                @unique
  pagoProveedor           PagoProveedor?         @relation("MovimientoCaja_pagoProveedor_PagoProveedor", fields: [pagoProveedorId], references: [id], onDelete: Restrict)
  liquidacionRepartidorId String?                @unique
  liquidacionRepartidor   LiquidacionRepartidor? @relation("MovimientoCaja_liquidacionRepartidor_LiquidacionRepartidor", fields: [liquidacionRepartidorId], references: [id], onDelete: Restrict)
  usuarioId               String
  usuario                 Usuario                @relation("MovimientoCaja_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn                DateTime               @default(now()) @db.Timestamptz(3)

  @@index([turnoId, creadoEn])
}

model ArqueoCaja {
  id             String    @id @default(cuid())
  turnoId        String    @unique
  turno          TurnoCaja @relation("ArqueoCaja_turno_TurnoCaja", fields: [turnoId], references: [id], onDelete: Restrict)
  contado        Decimal   @db.Decimal(18, 2)
  esperado       Decimal   @db.Decimal(18, 2)
  diferencia     Decimal   @db.Decimal(18, 2)
  realizadoPorId String
  realizadoPor   Usuario   @relation("ArqueoCaja_realizadoPor_Usuario", fields: [realizadoPorId], references: [id], onDelete: Restrict)
  nota           String?
  realizadoEn    DateTime  @default(now()) @db.Timestamptz(3)
}

model ConfiguracionProveedorPago {
  id                 String   @id @default(cuid())
  sucursalId         String
  sucursal           Sucursal @relation("ConfiguracionProveedorPago_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  codigoProveedor    String
  nombre             String
  referenciaSecretos String? // Referencia a secret manager; NUNCA credenciales ni CVV.
  activo             Boolean  @default(true)

  // Relaciones inversas (navegación Prisma)
  intentoPagosComoProveedor IntentoPago[] @relation("IntentoPago_proveedor_ConfiguracionProveedorPago")

  @@unique([sucursalId, codigoProveedor])
}

model IntentoPago {
  id                String                      @id @default(cuid())
  cuentaId          String
  cuenta            Cuenta                      @relation("IntentoPago_cuenta_Cuenta", fields: [cuentaId], references: [id], onDelete: Restrict)
  proveedorId       String?
