 conciliadoEn DateTime? @db.Timestamptz(3)
 validacionReferencia String? @db.VarChar(40)
 justificacionConciliacion String? @db.VarChar(500)
 creadoEn DateTime @default(now()) @db.Timestamptz(3)
 @@unique([cuentaFinancieraId,claveExterna])
 @@index([cuentaFinancieraId,fecha])
}

model ReversaFinanciera {
