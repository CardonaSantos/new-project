// ============================================================================
// [S15] PERFIL DE USUARIO Y MULTIMEDIA (DIGITALOCEAN SPACES / S3)
// ============================================================================
// El archivo real se guarda en Spaces, no en PostgreSQL.
// Para borrar se utiliza proveedor + bucket + claveObjeto, NO urlPublica.
// confirmadaEn valida que terminó la carga; eliminadaEn es soft-delete.
// Exigir imagen al publicar en el menú corresponde al caso de uso, no a un
// enum ni a un paso de aprobación. Reutilizar archivos evita duplicación.

enum TipoMedia {
  IMAGEN
  VIDEO
  DOCUMENTO
}

model Media {
  id               String    @id @default(cuid())
  sucursalId       String?
  sucursal         Sucursal? @relation("Media_sucursal_Sucursal", fields: [sucursalId], references: [id], onDelete: Restrict)
  contexto         String    @default("GENERAL") @db.VarChar(32)
  publico          Boolean   @default(false)
  proveedor        String    @default("DIGITALOCEAN_SPACES")
  bucket           String    @db.VarChar(255)
  region           String?   @db.VarChar(64)
  claveObjeto      String    @db.VarChar(1024)
  urlPublica       String?   @db.Text
  tipo             TipoMedia
  mimeType         String    @db.VarChar(128)
  nombreOriginal   String?
  tamanoBytes      BigInt?
  ancho            Int?
  alto             Int?
  duracionSegundos Decimal?  @db.Decimal(12, 3)
  etag             String?
  hashContenido    String?
  subidaPorId      String?
  subidaPor        Usuario?  @relation("Media_subidaPor_Usuario", fields: [subidaPorId], references: [id], onDelete: SetNull)
  confirmadaEn     DateTime? @db.Timestamptz(3)
  eliminadaEn      DateTime? @db.Timestamptz(3)
  creadoEn         DateTime  @default(now()) @db.Timestamptz(3)
  actualizadoEn    DateTime  @updatedAt @db.Timestamptz(3)

  perfilesComoAvatar PerfilUsuario[] @relation("PerfilUsuario_avatarMedia_Media")
  productosComoMedia ProductoMedia[] @relation("ProductoMedia_media_Media")
  variantesComoMedia VarianteProductoMedia[] @relation("VarianteProductoMedia_media_Media")
  articulosComoMedia ArticuloInventarioMedia[] @relation("ArticuloInventarioMedia_media_Media")
  categoriasComoMedia CategoriaMedia[] @relation("CategoriaMedia_media_Media")

  @@unique([proveedor, bucket, claveObjeto])
  @@index([eliminadaEn])
  @@index([tipo, creadoEn])
  @@index([sucursalId, contexto, creadoEn])
}

model PerfilUsuario {
  id            String   @id @default(cuid())
  usuarioId     String   @unique
  usuario       Usuario  @relation("PerfilUsuario_usuario_Usuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  apellidos     String?
  telefono      String?
  idioma        String   @default("es-GT")
  zonaHoraria   String   @default("America/Guatemala")
  avatarMediaId String?
  avatarMedia   Media?   @relation("PerfilUsuario_avatarMedia_Media", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  creadoEn      DateTime @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @db.Timestamptz(3)

  @@index([avatarMediaId])
}

model ProductoMedia {
  productoId String
  producto   Producto @relation("ProductoMedia_producto_Producto", fields: [productoId], references: [id], onDelete: Cascade)
  mediaId    String
  media      Media    @relation("ProductoMedia_media_Media", fields: [mediaId], references: [id], onDelete: Restrict)
  principal  Boolean  @default(false)
  orden      Int      @default(0)
  creadoEn   DateTime @default(now()) @db.Timestamptz(3)

  @@id([productoId, mediaId])
  @@index([productoId, principal, orden])
  @@index([mediaId])
}

model VarianteProductoMedia {
  varianteId String
  variante   VarianteProducto @relation("VarianteProductoMedia_variante_VarianteProducto", fields: [varianteId], references: [id], onDelete: Cascade)
  mediaId    String
  media      Media            @relation("VarianteProductoMedia_media_Media", fields: [mediaId], references: [id], onDelete: Restrict)
  principal  Boolean          @default(false)
  orden      Int              @default(0)
  creadoEn   DateTime         @default(now()) @db.Timestamptz(3)

  @@id([varianteId, mediaId])
  @@index([varianteId, principal, orden])
  @@index([mediaId])
}

